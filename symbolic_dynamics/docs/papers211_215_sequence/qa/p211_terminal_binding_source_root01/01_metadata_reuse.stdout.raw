    {
      "label": "preparation:21",
      "request": {
        "cmd": "node <<'NODE'\nconst fs=require('fs'),crypto=require('crypto'),path=require('path');const root='/root/autodl-tmp/symbolic_dynamics',qa='docs/papers211_215_sequence/qa/',prep=qa+'p211_round2_preparation01/',frozen='papers/211-kernel-image-projection-feedback/frozen_round2';const inputs={};function pin(b){return {bytes:b.length,sha256:crypto.createHash('sha256').update(b).digest('hex')};}function read(n){const f=root+'/'+n,a=fs.lstatSync(f);if(!a.isFile()||fs.realpathSync(f)!==f)throw Error('not physical '+n);const b=fs.readFileSync(f),z=fs.lstatSync(f);if(a.ino!==z.ino||a.size!==z.size||a.mtimeMs!==z.mtimeMs||a.ctimeMs!==z.ctimeMs)throw Error('drift '+n);const v=pin(b);if(inputs[n]&&JSON.stringify(inputs[n])!==JSON.stringify(v))throw Error('changed reread');inputs[n]=v;return b;}const obj=n=>JSON.parse(read(n));const lineage=obj(prep+'INFRASTRUCTURE_LINEAGE.json'),nine=obj(prep+'NINE_BUILD_SOURCES.json');const old=obj(lineage.original_build_lock.path);if(JSON.stringify(inputs[lineage.original_build_lock.path])!==JSON.stringify(lineage.original_build_lock.pin))throw Error('old lockpin');const initial=obj(lineage.original_build_binding.path);const adapters={},old_adapters={};for(const n of ['build_core.py','build_p211.py','launch_build.py','prepare_build.py','static_checks.py']){read(prep+'terminal_build/'+n);adapters[n]=inputs[prep+'terminal_build/'+n];const orig=Object.keys(lineage.original_build_sources).find(p=>p.endsWith('/'+n));read(orig);if(JSON.stringify(inputs[orig])!==JSON.stringify(lineage.original_build_sources[orig]))throw Error('oldsourcepin');old_adapters[n]=inputs[orig];}const one=obj(prep+'terminal_build/BINDING_1.pending.json'),two=obj(prep+'terminal_build/BINDING_2.pending.json');for(const n of [prep+'SHA256SUMS',prep+'terminal_build/PLAN.md',qa+'p211_round2_source_root_reception01/RECEPTION.md',qa+'p211_b_final_root/RECEPTION.md',qa+'p211_initial_build_root_reception/RECEPTION.md'])read(n);const rawseal=read(frozen+'/SHA256SUMS').toString();const payload={};for(const l of rawseal.trimEnd().split('\\n')){const m=/^([0-9a-f]{64})  (.+)$/.exec(l);if(!m||m[2]==='SHA256SUMS'||m[2].startsWith('/')||m[2].split('/').some(p=>['','.','..'].includes(p))||payload[m[2]])throw Error('manifest syntax');const n=frozen+'/'+m[2],b=read(n);if(pin(b).sha256!==m[1])throw Error('manifest original '+n);payload[m[2]]=pin(b);}if(Object.keys(payload).length!==123)throw Error('payload count');const all={...payload,SHA256SUMS:inputs[frozen+'/SHA256SUMS']};const actualFiles=[],actualDirs=['.'];function walk(p,b){for(const n of fs.readdirSync(p).sort()){const f=p+'/'+n,r=b?b+'/'+n:n,s=fs.lstatSync(f);if(fs.realpathSync(f)!==f||s.isSymbolicLink())throw Error('treealias');if(s.isDirectory()){actualDirs.push(r);walk(f,r);}else if(s.isFile())actualFiles.push(r);else throw Error('special');}}walk(root+'/'+frozen,'');const dirs=new Set(['.']);for(const n of Object.keys(all)){let p=path.posix.dirname(n);while(p!=='.'){dirs.add(p);p=path.posix.dirname(p);}}if(JSON.stringify(actualFiles.slice().sort())!==JSON.stringify(Object.keys(all).sort())||JSON.stringify(actualDirs.slice().sort())!==JSON.stringify([...dirs].sort()))throw Error('whole tree');for(const [n,v]of Object.entries(nine.sources)){const live='papers/211-kernel-image-projection-feedback/'+n;read(live);if(inputs[live].sha256!==v.sha256||all[n].sha256!==v.sha256||old.source_observations[n].sha256!==v.sha256||initial.source_pins[n].sha256!==v.sha256)throw Error('ninegraphpin');}const refresh={};for(const phase of ['precopy','postcopy']){const b=qa+'p211_round2_binding_root01/refresh02/'+phase+'01/';const r=obj(b+'RESULT.json'),ins=obj(b+'READ_INPUTS.json'),labels=obj(b+'CHECK_LABELS.json');read(b+'SHA256SUMS');const n=qa+'p211_round2_binding_root01/refresh02/'+phase.toUpperCase()+'_NATIVE01.json',native=obj(n),bn=qa+'p211_round2_binding_root01/refresh02/BUILD_'+phase.toUpperCase()+'_NATIVE01.json',build=obj(bn);refresh[phase]={result:r,input_rows:Object.keys(ins).length,labels_count:labels.length,labels_type:typeof labels,native_keys:Object.keys(native),native_result_keys:native.result?Object.keys(native.result):null,native_exit:native.result?.exit_code,build_native_keys:Object.keys(build),build_exit:build.result?.exit_code,build_output:build.result?.output};}const fields=Object.fromEntries(Object.entries(old).map(([k,v])=>[k,{type:Array.isArray(v)?'array':v===null?'null':typeof v,items:v&&typeof v==='object'?Object.keys(v).length:null,semantic_serialization_pin:pin(Buffer.from(JSON.stringify(v)))}]));for(const n of Object.keys(inputs))read(n);process.stdout.write(JSON.stringify({status:'DATA_ONLY_ORIGINAL_METADATA_NO_DERIVED_LOCK',inputs,old_lock_top_level_fields:fields,old_lock_schema:old.schema,old_lock_status:old.status,old_lock_environment:old.environment,old_lock_relative_roles:old.cwd_relative_absence_roles,old_lock_selector_count:Object.keys(old.selector_specs).length,old_lock_entry_count:Object.keys(old.entries).length,old_lock_code_observations:old.code_observations,initial_binding:initial,adapters,old_adapters,round2_all_file_pins:all,round2_directory_names:actualDirs.sort(),round2_payload_bytes:Object.values(payload).reduce((s,v)=>s+v.bytes,0),refresh,source_pins:nine.sources,template_delta:Object.keys(one).filter(k=>JSON.stringify(one[k])!==JSON.stringify(two[k])),no_host_dereferences:true,no_ambient_environment_collection:true,no_submitted_source_execution:true})+'\\n');\nNODE",
