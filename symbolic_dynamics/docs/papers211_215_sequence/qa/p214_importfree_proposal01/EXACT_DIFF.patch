+def wire_string(value):
+    """ASCII JSON string spelling; includes DEL and lone surrogates."""
+    escapes = {34: '\\"', 92: '\\\\', 8: '\\b', 12: '\\f',
+               10: '\\n', 13: '\\r', 9: '\\t'}
+    pieces = ['"']
+    for character in value:
+        code = ord(character)
+        if code in escapes:
+            pieces.append(escapes[code])
+        elif 0x20 <= code <= 0x7e:
+            pieces.append(character)
+        elif code <= 0xffff:
+            pieces.append("\\u" + format(code, "04x"))
+        else:
+            offset = code - 0x10000
+            pieces.append("\\u" + format(0xd800 + (offset >> 10), "04x")
+                          + "\\u" + format(0xdc00 + (offset & 0x3ff), "04x"))
+    pieces.append('"')
+    return "".join(pieces)
+
+
+def wire(value, active=None):
+    """Compact sorted-key JSON on P214's exact builtin-only value domain."""
+    if value is None:
+        return "null"
+    if value is True:
+        return "true"
+    if value is False:
+        return "false"
+    kind = type(value)
+    if kind is int:
+        return str(value)
+    if kind is str:
+        return wire_string(value)
+    if kind not in (list, tuple, dict):
+        raise TypeError("P214 JSON value is outside the proved source domain")
+    if active is None:
+        active = set()
+    marker = id(value)
+    if marker in active:
+        raise ValueError("Circular reference detected")
+    active.add(marker)
+    try:
+        if kind is dict:
+            if any(type(key) is not str for key in value):
+                raise TypeError("P214 JSON object keys must be exact strings")
+            return "{" + ",".join(wire_string(key) + ":" + wire(value[key], active)
+                                  for key in sorted(value)) + "}"
+        return "[" + ",".join(wire(item, active) for item in value) + "]"
+    finally:
+        active.remove(marker)
+
+
