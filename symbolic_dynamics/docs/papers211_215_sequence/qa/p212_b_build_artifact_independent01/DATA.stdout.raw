      "path": "raw/pdftotext.request.txt",
      "bytes": 210,
      "sha256": "0809b1fd77cd405d0ba1297a6df6edbcaa077a7103162a1c7f9c800209ea5ae2",
      "raw_utf8": "cwd=/root/autodl-tmp/symbolic_dynamics/docs/papers211_215_sequence/reviews/p212_b/build01/source_only\nsupervisor_argv=/usr/bin/timeout --signal=TERM --kill-after=10s 180s /usr/bin/pdftotext -layout main.pdf - \n"
