      "raw_utf8": "\\relax \n\\citation{manna1987}\n\\citation{loginov2007}\n\\citation{berdine2006}\n\\citation{pham2015}\n\\citation{holroyd2008}\n\\@writefile{toc}{\\contentsline {section}{\\numberline {1}The closed carrier and its active core}{1}{}\\protected@file@percent }\n\\newlabel{eq:update}{{1}{1}}\n\\newlabel{eq:inverse}{{2}{1}}\n\\newlabel{lem:core}{{1}{2}}\n\\@writefile{toc}{\\contentsline {section}{\\numberline {2}Exact returns and observable decorations}{2}{}\\protected@file@percent }\n\\newlabel{thm:table}{{2}{2}}\n\\@writefile{lot}{\\contentsline {table}{\\numberline {1}{\\ignorespaces All lengths are positive. Parallel edges have no state identities. In the last row, ``two paths direct'' means at least two.}}{3}{}\\protected@file@percent }\n\\newlabel{tab:periods}{{1}{3}}\n\\@writefile{toc}{\\contentsline {section}{\\numberline {3}The complete period set}{4}{}\\protected@file@percent }\n\\newlabel{cor:set}{{3}{4}}\n\\newlabel{eq:set}{{3}{4}}\n\\@writefile{toc}{\\contentsline {section}{\\numberline {4}A rational labelled orbit census}{4}{}\\protected@file@percent }\n\\newlabel{thm:census}{{4}{4}}\n\\newlabel{eq:c8}{{4}{4}}\n\\newlabel{eq:cb}{{5}{4}}\n\\newlabel{eq:ct}{{6}{4}}\n\\newlabel{eq:full}{{8}{4}}\n\\newlabel{eq:cscalar}{{9}{4}}\n\\bibstyle{plain}\n\\bibdata{references}\n\\newlabel{eq:weight}{{10}{5}}\n\\@writefile{toc}{\\contentsline {section}{\\numberline {5}Evidence scope and limitations}{5}{}\\protected@file@percent }\n\\bibcite{berdine2006}{1}\n\\bibcite{holroyd2008}{2}\n\\bibcite{loginov2007}{3}\n\\bibcite{manna1987}{4}\n\\bibcite{pham2015}{5}\n\\gdef \\@abspage@last{6}\n"
