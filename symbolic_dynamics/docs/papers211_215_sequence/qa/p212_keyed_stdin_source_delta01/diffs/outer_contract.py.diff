+def stdin_descriptor(d):
+    need(d['path'] == STDIN_FILE and d['role'] == 'stdin' and d['kind'] == 'file'
+         and d['comparison'] == 'stable' and d['resolved'] == STDIN_FILE
+         and d['symlink_target'] is None and d['members'] is None,
+         'one physical keyed regular stdin descriptor')
+    equal(d['content'],EMPTY_CONTENT,'stdin independently bound complete zero-byte content')
+    for name in ('lstat','stat'):
+        keys(d[name],STATS,'stdin full fourteen-field expected key')
+        equal(kind(d[name]),'file','stdin expected metadata is regular')
+        equal(d[name]['size'],'0','stdin expected size is exactly zero')
+    equal(projection(d['lstat']),projection(d['stat']),'physical stdin lstat/stat agree')
+    return d
+
+def open_stdin():
+    # Private fresh open; no seek/fdinfo query is added. Initial/handoff offset
+    # zero is source-derived from fresh open and the sole current-position read
+    # returning zero, not an actual offset observation or null-device equivalence.
+    observation = {'path':STDIN_FILE,'role':'stdin','kind':'file','fd':None,
+        'open_flags':'O_RDONLY|O_NOFOLLOW|O_NONBLOCK','alias_chain':None,
+        'before':None,'after':None,'read_requested_bytes':1,'read_return_bytes':None,
+        'raw_hex':None,'content':None,'source_initial_offset':0,
+        'source_handoff_offset':None,'actual_offset_query':None,
+        'offset_basis':'SOURCE_DERIVED_FRESH_OPEN_AND_ONLY_ZERO_RETURN_CURRENT_POSITION_READ',
+        'native_mask_required':0xFFF}
+    fd = None
+    try:
+        d = stdin_descriptor(BOUND[STDIN_FILE])
+        resolved, chain = resolve(STDIN_FILE)
+        equal(resolved,STDIN_FILE,'stdin exact physical resolution')
+        need(all(row['symlink_target'] is None for row in chain),'stdin physical ancestors, no hidden alias')
+        observation['alias_chain'] = chain
+        fd = os.open(STDIN_FILE,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
+        observation['fd'] = fd
+        before = full_stat(fd=fd)
+        observation['before'] = before
+        equal(kind(before['fields']),'file','opened stdin fd is regular')
+        equal(before['fields']['size'],'0','opened stdin fd is empty')
+        equal(projection(before['fields']),projection(d['stat']),'expected stdin key before any byte read')
+        raw = os.read(fd,1)
+        observation['read_return_bytes'] = len(raw)
+        observation['raw_hex'] = raw.hex()
+        need(not raw,'stdin grew or yielded data; retain at most one failure sentinel byte')
+        after = full_stat(fd=fd)
+        observation['after'] = after
+        equal(kind(after['fields']),'file','stdin remains regular')
+        equal(after['fields']['size'],'0','stdin remains empty')
+        equal(projection(after['fields']),projection(before['fields']),'stdin same handle after whole zero-byte read')
+        observation['content'] = value(raw)
+        equal(observation['content'],EMPTY_CONTENT,'actual entire empty stdin content')
+        observation['source_handoff_offset'] = 0
+        return fd, observation
+    except BaseException as error:
+        close_error = None
+        if fd is not None:
+            try:
+                os.close(fd)
+            except BaseException as closing:
+                close_error = repr(closing)
+        failure = {'observation':observation,'error':repr(error),'close_error':close_error,
+                   'child_started_by_this_open':False,'stdin_handoff':False,'final_success':False}
+        if CREATED:
+            record('STDIN_FAILURE.json',failure)
+        else:
+            print('HOLD_STDIN: '+json.dumps(failure,sort_keys=True),file=sys.stderr,flush=True)
+        raise
