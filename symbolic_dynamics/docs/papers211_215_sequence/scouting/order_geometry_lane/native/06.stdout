    # C06: parallel candy-sharing, retain floor half and send ceil half right.
    phase = compositions(5, 4)

    def candy(config):
        return tuple(config[i] // 2 + (config[(i - 1) % 4] + 1) // 2
                     for i in range(4))

    rows.append(("C06/CSH", functional_signature(phase, candy)))
