    {"N":[64,128,256],"b":2,"case_id":"FIN-B2-Q2-SIGMA1","controls":["ADJACENT_SHELL","DIRECT_POSITIVE_PREFIX","ZERO_DELETED"],"evidence_type":"FINITE_OPERATOR_CONTROL","q":"2","r":[2,3,4],"shell_pairs_by_control":{"ADJACENT_SHELL":[[1,0],[3,2]]},"sigma":"1"},
    {"N":[128,256,512],"b":2,"case_id":"FIN-B2-Q3-ADJACENT","controls":["ADJACENT_SHELL","DIRECT_POSITIVE_PREFIX"],"evidence_type":"FINITE_OPERATOR_CONTROL","q":"3","r":[2,3,4],"shell_pairs_by_control":{"ADJACENT_SHELL":[[2,1],[4,3]]},"sigma":"6/5"},
