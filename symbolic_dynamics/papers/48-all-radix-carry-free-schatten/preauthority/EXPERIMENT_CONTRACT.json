    {"N":[81,243,729],"b":3,"case_id":"FIN-B3-Q2-SAME-SHELL","controls":["CROSS_SHELL","DIRECT_POSITIVE_PREFIX","SAME_SHELL"],"evidence_type":"FINITE_OPERATOR_CONTROL","q":"2","r":[1,2,3,4],"shell_pairs_by_control":{"CROSS_SHELL":[[3,1]],"SAME_SHELL":[[1,1],[3,3]]},"sigma":"5/4"},
