    {"case_id":"INF-DIGIT-WALL","evidence_type":"INFINITE_THEOREM_CERTIFICATE","parameter_rows":["sigma<log_b_kappa_b_q","sigma=log_b_kappa_b_q","sigma>log_b_kappa_b_q"],"theorem_field":"S_q_iff_sigma_gt_max_of_walls"},
