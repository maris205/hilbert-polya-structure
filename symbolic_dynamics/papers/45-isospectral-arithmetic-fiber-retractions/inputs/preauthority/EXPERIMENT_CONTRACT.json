  "evidence_types": {
    "FINITE_COMPRESSION": {
      "designated_consumers": ["A", "B", "X"],
      "forbidden_fields": [
        "infinite_boundedness_iff",
        "infinite_ideal_iff",
        "infinite_similarity_iff",
        "tauberian_conclusion",
        "trace_or_determinant_domain_proof"
      ],
      "output_schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/finiteCompressionRecord"
    },
    "FINITE_OPTIMIZATION": {
      "designated_consumers": ["A", "B", "X"],
      "forbidden_fields": [
        "infinite_maximal_order_asymptotic",
        "tauberian_conclusion"
      ],
      "output_schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/finiteOptimizationRecord"
    },
    "INFINITE_THEOREM_CERTIFICATE": {
      "designated_consumers": ["B", "P"],
      "forbidden_consumers": ["A", "X"],
      "output_schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/infiniteCertificateRecord"
    }
  },
  "precision_bits": [128, 256, 512],
  "interval_width_targets": {
    "128": "1e-30",
    "256": "1e-60",
    "512": "1e-120"
  },
  "serialization": {
    "booleans": "JSON true or false; never integer",
    "complex": "exact inputs and residuals only: object with normalized reduced rational-string real and imag",
    "dirichlet_power_ast": "DIRICHLET_POWER envelope: base and exponent numerator/denominator are canonical integer strings; exact RFC8785 JCS UTF-8 and lowercase SHA-256 are stored",
    "exact_sets": "C-sorted duplicate-free arrays",
    "integers": "JSON integer; never Boolean or float",
    "rationals": "reduced signed p/q string with positive denominator",
    "unknown_fields": "rejected by additionalProperties false"
  },
  "output_artifacts": [
    {"path": "results/SHA256SUMS.txt", "producer": "MANIFEST_BUILDER", "required": true, "schema_ref": "sha256sum-v1-self-excluding-C-sort"},
    {"path": "results/comparator_x.json", "producer": "X", "required": true, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/comparisonReport"},
    {"path": "results/evaluation_report.json", "producer": "EVALUATION_DRIVER", "required": true, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/evaluationReport"},
    {"path": "results/evaluator_a.json", "producer": "A", "required": true, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/scienceProjection"},
    {"path": "results/evaluator_b.json", "producer": "B", "required": true, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/scienceProjection"},
    {"path": "results/integrity_audit.json", "producer": "G", "required": true, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/integrityReport"},
    {"path": "results/mutation_outcomes.json", "producer": "MUTATION_RUNNER", "required": true, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/mutationBundle"},
    {"path": "results/proof_auditor_p.json", "producer": "P", "required": true, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/proofAudit"}
  ],
  "metadata_identity": {
    "identity_scope": "all declared target files and their declared parent directories",
    "tuple_fields": ["path", "file_type", "sha256", "size_bytes", "mode", "mtime_ns"],
    "uid_gid_excluded_for_relocation": true
  },
  "transaction_policy": {
    "forced_late_failure_checkpoint": "after_complete_stage_validation_before_directory_rename",
    "install_primitive": "same_filesystem_atomic_directory_rename",
    "preexisting_different_target": "reject_TARGET_EXISTS_DIFFERENT_without_write",
    "preexisting_identical_target": "success_with_zero_physical_replacements",
    "stage_directory": "results.__stage__",
    "stage_failure_cleanup": "remove_stage_only_never_touch_target",
    "target_directory": "results"
  },
  "artifact_path_policy": {
    "allow_relative_paths_only": true,
    "cache_aux_and_host_tokens_forbidden": true,
    "declared_output_set_is_exact": true,
    "parent_segments_forbidden": true,
    "pre_io_symlink_and_nonregular_rejection": true,
    "undeclared_paths_forbidden": true
  },
  "outcome_totalization": {
    "allowed_outcomes": {
      "ACCEPT": {"exit_code": 0, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/acceptOutcome"},
      "HARNESS_ERROR": {"exit_code": 3, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/harnessErrorOutcome"},
      "REJECT": {"exit_code": 2, "schema_ref": "EXPERIMENT_CONTRACT_SCHEMA.json#/$defs/rejectOutcome"}
    },
    "event_mapping": {
      "ast_scalar_type_or_lexeme_violation": "REJECT:exact_case_grid_code",
      "consumer_output_schema_failure": "HARNESS_ERROR:SCHEMA_ERROR",
      "duplicate_json_member": "REJECT:DUPLICATE_JSON_MEMBER",
      "internal_exception": "HARNESS_ERROR:INTERNAL_EXCEPTION",
      "io_failure": "HARNESS_ERROR:IO_ERROR",
      "malformed_consumer_payload": "HARNESS_ERROR:MALFORMED_PAYLOAD",
      "mutation_semantic_rejection": "REJECT:exact_registry_code",
      "normal_valid_result": "ACCEPT",
      "noncanonical_ast_storage": "REJECT:NONCANONICAL_AST_STORAGE",
      "process_nonzero_unclassified": "HARNESS_ERROR:NONZERO_EXIT",
      "raw_input_parse_failure": "HARNESS_ERROR:PARSE_ERROR",
      "timeout": "HARNESS_ERROR:TIMEOUT"
    },
    "raw_exception_text_forbidden": true,
    "unhandled_exception_forbidden": true
  },
  "mutation_execution": {
    "json_pointer_standard": "RFC6901",
    "pointer_precondition": "resolve target in fresh disposable copy and require JSON type and value equal value_from before replacement",
    "precondition_failure": "HARNESS_ERROR:MUTATION_PRECONDITION_FAILED",
    "production_artifacts_never_mutated": true,
    "registry_schema": "MUTATION_REGISTRY_SCHEMA.json",
    "typed_operation_precondition": "validate complete operation object before any filesystem action"
  },
  "semantic_validation": {
    "case_ids_unique": true,
    "common_case_ids_resolve_to_declared_evidence_type": true,
    "exact_output_artifact_array_required": true,
    "finite_compression_cutoff_precision_pairs_required": true,
    "finite_compression_pairing_rule": "zip each finite-compression case.cutoffs with precision_bits in array order",
    "interval_rule": "parse finite decimals; require lower<=upper, matching precision_bits/width_target, and upper-lower<=width_target",
    "mutation_ids_unique_and_C_sorted": true,
    "mutation_pointer_preconditions_required": true,
    "output_parent_and_producer_coverage_exact": true,
    "ast_canonicalization_rule": "duplicate-member token scan before object construction; validate canonical integer strings and reduced rationals; RFC8785-canonicalize unique-member objects; require stored JCS bytes and SHA-256 exact",
    "infinite_coverage_rule": "derive C-sorted INF IDs from case_registry and require exact ordered_case_ids; recompute ordered_set_sha256; require exact A/B/P arrays; reject missing extra duplicate reordered or undeclared INF case; close B-to-P owner/hash fields by case_id",
    "rational_rule": "parse p or p/q; denominator positive; gcd(abs(p),q)=1; zero serialized as 0",
    "set_arrays_C_sorted_and_duplicate_free": true
  },
  "mutation_baseline": {
    "case": {
      "basis_index": "1",
      "determinant_order_r": 2,
      "h": 2,
      "k": 1,
      "label_m": "6",
      "q": "2",
      "sigma": "real_part_of_s"
    },
    "cases": {
      "INF-CROSSOVER-ALLH": {"sigma_1": "1"}
    },
    "claims": {
      "commutator": {"domain": "sigma*q>1", "h2_witness": "two_saturated_primes"},
      "determinant": {"domain": "r*sigma>2"},
