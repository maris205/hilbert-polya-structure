{
  "allowed_json_scalar_types": [
    "boolean",
    "integer",
    "null",
    "string"
  ],
  "canonical_envelope_keys": [
    "payload",
    "schema",
    "status"
  ],
  "comparison_required_sections": [
    "case_counts",
    "evidence_boundary",
    "finite_projection_sha256",
    "gamma_overlap",
    "positive_controls",
    "radial_projection_sha256",
    "residue_projection_sha256",
    "status"
  ],
  "forbidden_numeric_types": [
    "binary_float",
    "json_number_with_fraction_or_exponent"
  ],
  "rational": {
    "denominator": "positive_decimal_integer_string",
    "numerator": "signed_decimal_integer_string"
  },
  "interval_truth_rule": "independent_exact_reconstruction_of_grid_identifier_metadata_outward_endpoints_truncation_and_analytic_tail",
  "schema": "paper44-result-schema-v1",
  "strict_equality": "recursive_exact_runtime_type_then_value_then_canonical_bytes",
  "strict_integer_rule": "runtime_type_is_exactly_int_and_never_bool",
  "unknown_or_missing_key_rule": "reject_at_every_envelope_payload_and_record_level"
}
