    {
      "roadmap_item_id": "REV-R1-1",
      "reviewer_comment": "The replay remains non-row-level and the ordered P29-S01--P29-S22 inventory is not hash-linked to the evidence matrix.",
      "author_response": "We ran all 53 frozen query lines verbatim on 2026-09-04 under a declared top-three, no-pagination bound and emitted a 144-row retrieval/deduplication/screening ledger: 139 current manifestations plus five explicit unavailable query rows. The deterministic 22-row crosswalk binds every P29-S01--P29-S22 inventory row to the same-ID matrix row and hashes both exact TSV rows. The original-session rejected-row identifiers and decisions remain explicitly unavailable; the current replay does not reconstruct them.",
      "change_location": "Emitted replacements for B0048, B0080, B0089, and B0107.",
      "status": "PROVISIONALLY_RESOLVED_PENDING_APPLY",
      "mechanical_change_block_ids": null
    },
