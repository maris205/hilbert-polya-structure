# Python and test caches
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]

# Local environments and editor state
**/.venv/
**/.env
**/.ipynb_checkpoints/
**/.DS_Store

# Rebuildable LaTeX products
**/build/
**/*.aux
**/*.bbl
**/*.blg
**/*.fdb_latexmk
**/*.fls
**/*.log
**/*.out
**/*.synctex.gz
**/*.toc
**/manuscript/paper7_analytic_v3.pdf

# Rebuildable native binaries (sources and certificate transcripts stay tracked)
**/results/**/capd_r401_local_slab_grid_mp
**/results/**/capd_r401_local_slab_mp
**/results/**/capd_r401_local_complement_mp

# Exact executables bound by authoritative release manifests.  These two
# exceptions keep a fresh-clone checker self-contained; failed/superseded
# attempt binaries remain ignored by the rules above.
!zeta_mvp0/papers/paper_02_certified_local_wave_trace/results/r401_val_l1_branch/capd_r401_local_slab_grid_mp
!zeta_mvp0/papers/paper_02_certified_local_wave_trace/results/r401_val_l2_s0_local_complement/capd_r401_local_complement_mp

# The formal A1 working archive can grow to tens of GiB.  Keep its immutable
# freeze, run binding, aggregate/checker/release objects in Git, but leave the
# per-node and per-tree bulk payloads on the bound production filesystem.
zeta_mvp0/papers/paper_02_certified_local_wave_trace/results/r401_val_l2_all_slabs/raw/
zeta_mvp0/papers/paper_02_certified_local_wave_trace/results/r401_val_l2_all_slabs/trees/
zeta_mvp0/papers/paper_02_certified_local_wave_trace/results/r401_val_l2_all_slabs/tree_manifests/
