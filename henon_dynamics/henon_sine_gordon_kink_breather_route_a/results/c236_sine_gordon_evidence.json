      "name": "kink_speed_domain"
    },
    {
      "formula": "E=8 gamma",
      "name": "kink_energy"
    },
    {
      "formula": "P=8 gamma v under P=-integral u_t u_x",
      "name": "kink_momentum"
    },
    {
      "formula": "Q=(u(+infinity)-u(-infinity))/(2pi)",
      "name": "topological_charge"
    },
    {
      "formula": "u=4 atan(eta sin(Omega t)/(Omega cosh(eta x)))",
      "name": "breather_profile"
    },
    {
      "formula": "eta^2+Omega^2=1",
      "name": "breather_dispersion"
    },
    {
      "formula": "E_rest=16 eta",
      "name": "breather_energy"
    },
    {
      "formula": "(E,P)=(gamma_V E_rest,gamma_V V E_rest)",
      "name": "lorentz_energy_momentum"
    },
    {
      "formula": "-d^2+1-2sech^2=A^*A",
      "name": "hessian_factorization"
    },
    {
      "formula": "spec={0} union [1,infinity)",
      "name": "hessian_spectrum"
    }
  ],
  "frozen_object": {
    "boost_coordinates": "xi=gamma_V(x-Vt), tau=gamma_V(t-Vx)",
    "breather_formula": "u_B=4 atan(eta sin(Omega tau)/(Omega cosh(eta xi)))",
    "clock": "physical PDE time; breather 2pi/Omega is rest/comoving internal period, not a lab fixed-x period when V!=0",
