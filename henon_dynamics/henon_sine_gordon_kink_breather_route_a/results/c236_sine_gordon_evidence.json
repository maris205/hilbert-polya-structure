    {
      "formula": "u_tt-u_xx+sin(u)=0",
      "name": "sine_gordon_pde"
    },
    {
      "formula": "U=4 atan(exp(xi)), U''=sin U",
      "name": "kink_profile"
    },
    {
      "formula": "U=4 atan(exp(-xi)), U''=sin U",
      "name": "antikink_profile"
    },
    {
