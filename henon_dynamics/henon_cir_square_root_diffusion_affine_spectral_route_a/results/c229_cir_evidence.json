    },
    {
      "formula": "z L_n''+(alpha-z)L_n'+n L_n=0",
      "name": "laguerre_eigen_equation"
    },
    {
      "formula": "int L_n L_m z^(alpha-1)e^-z dz=Gamma(n+alpha)/n! delta_nm",
      "name": "laguerre_orthogonality"
    },
    {
      "formula": "E_pi[(f-pi f)^2]<=kappa^-1 E_pi[(sigma^2/2)x(f')^2]",
      "name": "poincare_gap"
    },
    {
      "formula": "P_x(X_t=0)=exp[-x e^-kappa t/h_t] for theta=0,kappa>0,sigma>0; h_t=sigma^2(1-e^-kappa t)/(2kappa)",
      "name": "zero_dimension_atom"
    }
