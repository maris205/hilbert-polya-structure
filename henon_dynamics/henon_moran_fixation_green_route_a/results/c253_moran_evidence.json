  "exact_identities": [
    {
      "formula": "lambda_i=beta*rho*i*(N-i)/N; mu_i=beta*i*(N-i)/N",
      "identity_id": "rates"
    },
    {
      "formula": "Q_ii=-(lambda_i+mu_i), Q_i,i+1=lambda_i, Q_i,i-1=mu_i",
      "identity_id": "generator"
    },
    {
      "formula": "u_i=(1-rho^{-i})/(1-rho^{-N})",
      "identity_id": "fixation_selected"
    },
    {
      "formula": "u_i=i/N",
      "identity_id": "fixation_neutral"
    },
    {
      "formula": "lambda_i(u_{i+1}-u_i)+mu_i(u_{i-1}-u_i)=0",
      "identity_id": "backward_equation"
    },
    {
      "formula": "lambda_i(t_{i+1}-t_i)+mu_i(t_{i-1}-t_i)=-1",
      "identity_id": "time_equation"
    },
    {
      "formula": "G=(-Q)^(-1)",
      "identity_id": "green_inverse"
    },
    {
      "formula": "w_i lambda_i=w_{i+1} mu_{i+1}",
      "identity_id": "detailed_balance"
    },
    {
      "formula": "finite transient Q is nonsingular for beta>0",
      "identity_id": "absorption"
    },
    {
      "formula": "rho=1 gives u_i=i/N",
      "identity_id": "neutral_face"
    }
  ],
