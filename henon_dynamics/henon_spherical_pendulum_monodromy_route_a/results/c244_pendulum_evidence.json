    },
    {
      "formula": "I=(1/pi) integral_(r1)^(r2) sqrt(P)/(1-u^2) du",
      "identity_id": "action_quadrature"
    },
    {
      "formula": "Delta_phi/(2*pi)=p/q in lowest terms iff closure after q u-oscillations; kq is the kth repetition",
      "identity_id": "torus_closure"
    },
    {
      "formula": "M_(alpha,beta)=[[1,1],[0,1]] for positive focus-focus loop",
      "identity_id": "focus_monodromy"
    },
    {
      "formula": "global (r,p) in R^3 x R^3 removes the theta=0,pi coordinate singularity",
      "identity_id": "pole_regularization"
    }
