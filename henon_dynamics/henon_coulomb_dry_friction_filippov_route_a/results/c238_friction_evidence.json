  "exact_identities": [
    {
      "formula": "d[(v^2+omega^2*x^2)/2]/dt=-c*|v|",
      "identity_id": "energy_slip"
    },
    {
      "formula": "v=0 and |omega^2*x|<=c",
      "identity_id": "static_set"
    },
    {
      "formula": "for c>0, x_1=2(c/omega^2)-A",
      "identity_id": "positive_rest_map"
    },
    {
      "formula": "for c>0, |A_{k+1}|=|A_k|-2c/omega^2",
      "identity_id": "turning_reduction"
    },
    {
      "formula": "for c>0, n=ceil((A-a_friction)/(2a_friction))",
      "identity_id": "capture_count"
    },
    {
      "formula": "x=-a_friction+R cos(theta)",
      "identity_id": "v_positive_center"
    },
    {
      "formula": "x=+a_friction+R cos(theta)",
      "identity_id": "v_negative_center"
    },
    {
      "formula": "x=x0 cos(omega t)+(v0/omega)sin(omega t)",
      "identity_id": "harmonic_solution"
    },
    {
      "formula": "E(t)=E(0) when c=0",
      "identity_id": "harmonic_energy"
    },
    {
      "formula": "x>a_friction => x_ddot=-omega^2*x+c<0; x<-a_friction => x_ddot=-omega^2*x-c>0",
      "identity_id": "threshold_release"
    }
  ],
