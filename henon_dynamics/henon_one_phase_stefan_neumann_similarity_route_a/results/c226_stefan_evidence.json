  "exact_identities": [
    {
      "formula": "u_t-u_xx=0 after eta=x/(2 sqrt(t))",
      "name": "similarity_heat_equation"
    },
    {
      "formula": "beta lambda=exp(-lambda^2)/(sqrt(pi) erf(lambda))",
      "name": "stefan_balance"
    },
    {
      "formula": "F'(lambda)=sqrt(pi)e^(lambda^2)erf(lambda)(1+2lambda^2)+2lambda>0",
      "name": "root_derivative"
    },
    {
      "formula": "Integral_0^t J_wall=Integral_0^s u dx+beta s",
      "name": "energy_integral"
    },
    {
      "formula": "Integral_0^{2lambda sqrt(t)}u dx=2sqrt(t)(1-e^(-lambda^2))/(sqrt(pi)erf(lambda))",
      "name": "sensible_integral"
    },
    {
      "formula": "Ste<sqrt(pi lambda^2)e^(lambda^2)<Ste+1",
      "name": "lambert_enclosure"
    }
  ],
