  "theorem": {
    "entry": "Every interior trajectory reaches a switching section in at most 2h, then follows the exact two-leg cycle.",
    "event_map": "Each leg has time 2h and maps y to exp(-2 gamma h)y; the full return map on Sigma_- is y -> exp(-4 gamma h)y.",
    "grazing": "y=0 is a transverse-neutral geometric grazing label only; no sliding segment is introduced.",
    "no_zeno": "All successive event times equal 2h>0, so finite-time Zeno accumulation is impossible.",
    "periodic_set": "For gamma>0 the unique periodic orbit is y=0 with period 4h; for gamma=0 every constant y is periodic with the same phase period.",
    "route_boundary": "The relay flow has no arithmetic labels, target determinant, or Hilbert--Polya operator.",
    "wellposedness": "The guard-priority hybrid convention gives a unique forward execution from every consistent interior/boundary state."
  }
}
