  "exact_identities": [
    {
      "formula": "-c*U'+6*U*U'+U'''=0",
      "id": "traveling_reduction"
    },
    {
      "formula": "U''=c*U-3*U^2+A",
      "id": "profile_ode"
    },
    {
      "formula": "(U')^2=-2*U^3+c*U^2+2*A*U+B",
      "id": "energy_cubic"
    },
    {
      "formula": "(U')^2=2*(r3-U)*(U-r2)*(U-r1)",
      "id": "root_factor"
    },
    {
      "formula": "c=2*(r1+r2+r3)",
      "id": "speed"
    },
    {
      "formula": "A=-(r1*r2+r1*r3+r2*r3); B=2*r1*r2*r3",
      "id": "integration_constants"
    },
    {
      "formula": "m=(r3-r2)/(r3-r1) in (0,1)",
      "id": "modulus"
    },
    {
      "formula": "L=2*sqrt(2/(r3-r1))*K(m)",
      "id": "period"
    },
    {
      "formula": "mean(U)=r1+(r3-r1)*E(m)/K(m)",
      "id": "mean"
    },
    {
      "formula": "U=r1+(r3-r1)*sech^2(sqrt((r3-r1)/2)*xi) when r1=r2",
      "id": "soliton"
    },
    {
      "formula": "L->2*pi/sqrt(2*(r3-r1)) when r2->r3",
      "id": "harmonic"
    },
    {
      "formula": "u_a(x,t)=u(x-6*a*t,t)+a; roots->roots+a; c->c+6*a",
      "id": "galilean"
    },
    {
      "formula": "T=L/abs(c) for c!=0 on the fundamental circle; c=0 is stationary",
      "id": "circle_clock"
    },
    {
      "formula": "source traveling-wave periods are continuously tunable and carry no rational-prime clock",
      "id": "route_stop"
    }
  ],
  "fixed_epoch": 1788048000,
  "frozen_object": {
    "arithmetic_origin": "none; continuously tunable dispersive-wave roots",
