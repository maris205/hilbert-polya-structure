  "exact_identities": [
    {
      "formula": "H_x*x_dot+H_v*v_dot=0",
      "identity_id": "hamiltonian_conservation"
    },
    {
      "formula": "V(x)+delta^2/(4 beta)=beta/4*(x^2+delta/beta)^2 for delta<0",
      "identity_id": "double_well_factor"
    },
    {
      "formula": "beta*y^2/4+delta*y/2-E=0, y=x^2",
      "identity_id": "turning_quadratic"
    },
    {
      "formula": "dI/dE=T/(2*pi)",
      "identity_id": "action_period"
    },
    {
      "formula": "x_h=sqrt(2)*sqrt(-delta/beta)*sech(sqrt(-delta)*t)",
      "identity_id": "homoclinic_profile"
    },
    {
      "formula": "V''(±sqrt(-delta/beta))=-2 delta",
      "identity_id": "well_frequency"
    },
    {
      "formula": "T(E)*E^(1/4)*beta^(1/4) is constant when delta=0",
      "identity_id": "quartic_scaling"
    },
    {
      "formula": "(x,v,t)->(x,-v,-t)",
      "identity_id": "time_reversal"
    }
  ],
  "fixed_epoch": 1787875200,
  "frozen_object": {
    "allowed_data": "exact potential identities, turning roots, quadratures, equilibria and linearized rates",
