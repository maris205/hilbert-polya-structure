\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Frozen implementation and control audit. (a) Each of three splits completed \(16{,}777{,}216\) identified per-step forward/inverse checks with no boundary failure or edge mismatch. (b) Their common maximum roundtrip error was \(1.388\times 10^{-16}\), below the predeclared threshold. (c) Independent 100-digit parent residuals were below the \(10^{-75}\) target; this was not interval certification. (d) Six matched controls separately test enumeration/symplecticity, paired reversal, dissipation, label loss, anti-symplectic rejection, and dependence of signed cancellation on factor signs.}}{14}{figure.3}\protected@file@percent }
\newlabel{fig:computational-audit}{{3}{14}{Frozen implementation and control audit. (a) Each of three splits completed \(16{,}777{,}216\) identified per-step forward/inverse checks with no boundary failure or edge mismatch. (b) Their common maximum roundtrip error was \(1.388\times 10^{-16}\), below the predeclared threshold. (c) Independent 100-digit parent residuals were below the \(10^{-75}\) target; this was not interval certification. (d) Six matched controls separately test enumeration/symplecticity, paired reversal, dissipation, label loss, anti-symplectic rejection, and dependence of signed cancellation on factor signs}{figure.3}{}}
