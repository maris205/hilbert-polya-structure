  "claims": [
    {
      "id": "C1",
      "statement": "The category is normalized monic-centered Jacobian-minus-one Henon maps over an algebraically closed characteristic-zero field.",
      "status": "ASSUMPTION_LOCK"
    },
    {
      "id": "C2",
      "statement": "On the length-2m fixed scheme, q is nilpotent with q squared zero and the formal multiplication spectrum is zero with multiplicity 2m.",
      "status": "PROVED_SCHEME_THEORETIC"
    },
    {
      "id": "C3",
      "statement": "The formal exact-period-two trace multiset is 2 with multiplicity (2m)^2-2m, retaining the nilpotent correction before diagonal subtraction.",
      "status": "PROVED_SCHEME_THEORETIC"
    },
    {
      "id": "C4",
      "statement": "Within normalized moduli, f_(m,a) and f_(m,b) are conjugate exactly when a^(2m-1)=b^(2m-1).",
      "status": "PROVED_NORMALIZED_ONLY"
    },
    {
      "id": "C5",
      "statement": "The cyclic equations at epsilon one encode Fix(f^3), and their Jacobian determinant is q0 q1 q2 plus epsilon squared times q0+q1+q2.",
      "status": "PROVED"
    },
    {
      "id": "C6",
      "statement": "The cyclic quotient is monic free of rank (2m)^3 over the parameter ring.",
      "status": "PROVED"
    },
    {
      "id": "C7",
      "statement": "The moment S_m equals the quotient trace of t_epsilon^m and the global residue of t_epsilon^(m+1).",
      "status": "PROVED_PRIOR_METHOD_SPECIALIZATION"
    },
    {
      "id": "C8",
      "statement": "Weighted homogeneity initially permits exactly four parameter monomials in S_m.",
      "status": "PROVED"
    },
    {
      "id": "C9",
      "statement": "The coefficient of a^(3(2m-1)) vanishes by the separated epsilon-zero algebra and nilpotence.",
      "status": "PROVED"
    },
    {
      "id": "C10",
      "statement": "The coefficient of a^(2(2m-1)) epsilon^m vanishes after the three nonfixed Puiseux patterns and the separate exact diagonal branch.",
      "status": "PROVED_LOCAL_DEGENERATION_IN_SOURCE_LOCK"
    },
    {
      "id": "C11",
      "statement": "For every m at least two, S_m(a,epsilon)=C_m epsilon^(3m)+D_m a^(2m-1) epsilon^(2m).",
      "status": "PROVED_UNIFORM_LAW"
    },
    {
      "id": "C12",
      "statement": "C_m is zero for odd m by cyclic reversal.",
      "status": "PROVED_COROLLARY"
    },
    {
      "id": "C13",
      "statement": "The displayed finite nested-binomial H/A/D expression equals D_m for every m at least two, including the separate j=0 flow.",
      "status": "PROVED_EXACT_CERTIFICATE_IN_SOURCE_LOCK"
    },
    {
      "id": "C14",
      "statement": "The fixed contribution to the formal period-three m-th trace moment is zero.",
      "status": "PROVED"
    },
    {
      "id": "C15",
      "statement": "Every normalized monic-centered quartic with formal fixed-point trace multiset zero to multiplicity four has p=(x^2-L)^2.",
      "status": "PROVED_QUARTIC_FULL_FIBER"
    },
    {
      "id": "C16",
      "statement": "On the quartic fiber, the pointwise exact-period-three second trace moment is -1296000-1572864 L^3.",
      "status": "PROVED_BY_TWO_SOURCE_LEVEL_DERIVATIONS"
    },
    {
      "id": "C17",
      "statement": "The formal exact-period-three pointwise length is 60 and the cyclewise moment is -432000-524288 L^3, after a separate local fixed-branch multiplicity proof.",
      "status": "PROVED_WITH_LOCAL_FIXED_BRANCH_MULTIPLICITY"
    },
    {
      "id": "C18",
      "statement": "Period three is the minimal conjugacy separator on the complete normalized quartic fiber with formal fixed-point trace multiset zero to multiplicity four.",
      "status": "PROVED_SCOPED_MINIMALITY"
    },
    {
      "id": "PC1",
      "statement": "The complete normalized quartic fiber is p=(x^2-L)^2; periods one and two are blind, while the exact-period-three moment is affine with nonzero L^3 slope and separates normalized conjugacy classes minimally.",
      "status": "PROVED_PROOF_ONLY"
    },
    {
      "id": "PC2",
      "statement": "For every symbolic m at least two, the two-term law, odd-m parity, and finite slope certificate hold; universal slope nonvanishing is not included.",
      "status": "PROVED_PROOF_ONLY"
    }
  ],
