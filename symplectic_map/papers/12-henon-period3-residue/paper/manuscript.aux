\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Weighted support and the two-term law. Weighted homogeneity permits exactly four parameter monomials in $S_m(a,\varepsilon )$. The separated algebra at $\varepsilon =0$ removes $a^{3(2m-1)}$, and the three nonfixed degeneration patterns together with the exact diagonal branch remove $a^{2(2m-1)}\varepsilon ^m$. The surviving terms are $C_m\varepsilon ^{3m}$ and $D_ma^{2m-1}\varepsilon ^{2m}$; cyclic reversal additionally gives $C_m=0$ for odd $m$. For $m=2$, source-level coefficient derivations give $S_2^{(3)}(L)=-1296000-1572864L^3$. The diagram makes no universal separation claim: $D_m\neq  0$ for every $m\geq 2$ remains open.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:weighted-two-term-law}{{2}{7}{Weighted support and the two-term law. Weighted homogeneity permits exactly four parameter monomials in $S_m(a,\varepsilon )$. The separated algebra at $\varepsilon =0$ removes $a^{3(2m-1)}$, and the three nonfixed degeneration patterns together with the exact diagonal branch remove $a^{2(2m-1)}\varepsilon ^m$. The surviving terms are $C_m\varepsilon ^{3m}$ and $D_ma^{2m-1}\varepsilon ^{2m}$; cyclic reversal additionally gives $C_m=0$ for odd $m$. For $m=2$, source-level coefficient derivations give $S_2^{(3)}(L)=-1296000-1572864L^3$. The diagram makes no universal separation claim: $D_m\neq 0$ for every $m\geq 2$ remains open}{figure.2}{}}
\newlabel{fig:weighted-two-term-law@cref}{{[figure][2][]2}{[1][7][]7}}
