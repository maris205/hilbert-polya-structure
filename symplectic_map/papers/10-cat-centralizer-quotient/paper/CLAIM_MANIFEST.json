  "claims": [
    {
      "claim_id": "C1",
      "statement": "For every q>=2, e1 is a universal cyclic vector, Cent_Mat2(R_q)(A)=R_q[A], and C_q=R_q[A]^x.",
      "locator": "paper/manuscript.tex#thm:torsor",
      "authority": "notes/PROOF_PACKAGE.md Steps 1-2",
      "status": "CLASSICAL_FIXED_MATRIX_PROOF",
      "boundary": "Field-free proof for the frozen matrix; no new centralizer or cyclic-matrix classification."
    },
    {
      "claim_id": "C2",
      "statement": "U maps to Ue1 bijectively from C_q to CV_q, so CV_q is a C_q-torsor contained in E_q.",
      "locator": "paper/manuscript.tex#eq:torsor-map",
      "authority": "notes/PROOF_PACKAGE.md Step 3",
      "status": "PROVED_TORSOR",
      "boundary": "The cyclic locus need not equal the complete shell."
    },
    {
      "claim_id": "C3",
      "statement": "Cyclic A-orbits are C_q/<A> and all have length ord_q(A).",
      "locator": "paper/manuscript.tex#eq:A-orbit-cosets",
      "authority": "notes/PROOF_PACKAGE.md Step 4",
      "status": "PROVED",
      "boundary": "A fixed-matrix orbit-coset identity, not a new finite-lattice cycle classification."
    },
    {
      "claim_id": "C4",
      "statement": "CV_q/C_q is one class, but A induces the identity map with native primitive period one and formal factor (1-z)^(-1).",
      "locator": "paper/manuscript.tex#eq:one-point-zeta",
      "authority": "notes/PROOF_PACKAGE.md Step 4 and quotient definition",
      "status": "PROVED_CLOCK_KILL",
      "boundary": "No new zeta definition and no impossibility theorem for enriched quotients."
    },
    {
      "claim_id": "C5",
      "statement": "Substituting z=q^(-s), or assigning length log q, supplies an external modulus label rather than a quotient return-time law.",
      "locator": "paper/manuscript.tex#eq:external-specialization",
      "authority": "notes/PROOF_PACKAGE.md Step 9",
      "status": "A0_FAIL_COMPONENT",
      "boundary": "All q^(-s) and log q expressions are symbolic; none is numerically evaluated."
    },
    {
      "claim_id": "C6",
      "statement": "The C_q^1-orbits on CV_q are exactly the Delta_q or norm fibers, hence CV_q/C_q^1 is im N_q.",
      "locator": "paper/manuscript.tex#eq:symplectic-quotient",
      "authority": "notes/PROOF_PACKAGE.md Steps 5-6",
      "status": "PROVED_SYMPLECTIC_BOUNDARY",
      "boundary": "No Hecke, quantum, representation, or equidistribution result."
    },
    {
      "claim_id": "C7",
      "statement": "The norm-image size is phi(q) when 5 does not divide q and phi(q)/2 when 5 divides q, including the binary and ramified-five boundaries.",
      "locator": "paper/manuscript.tex#eq:norm-image-cardinality",
      "authority": "notes/PROOF_PACKAGE.md Step 6",
      "status": "PROVED_LOW_NOVELTY",
      "boundary": "A fixed-order all-modulus assembly of established local norm analysis."
    },
    {
      "claim_id": "C8",
      "statement": "At primes the full nonzero shell has one, three, or two C_p-strata in the binary/inert, split, or ramified cases; the fixed reversor may pair d with -d but does not mix CV_p with its noncyclic complement.",
      "locator": "paper/manuscript.tex#prop:prime-strata",
      "authority": "notes/PROOF_PACKAGE.md Step 7",
      "status": "CLASSICAL_COROLLARY",
      "boundary": "No classification of arbitrary normalizers or power automorphisms."
    },
    {
      "claim_id": "C9",
      "statement": "The cyclic-locus cardinality has the stated CRT local formula, and the full cyclic quotient is one class at composite as well as prime moduli.",
      "locator": "paper/manuscript.tex#eq:all-q-one-class",
      "authority": "notes/PROOF_PACKAGE.md Steps 8-9",
      "status": "PROVES_TOO_MUCH_CONTROL",
      "boundary": "The four composite rows instantiate rather than prove the all-q theorem."
    },
    {
      "claim_id": "C10",
      "statement": "The one registered audit at q=(2,3,5,7,11,4,6,9,10) matches all 12 displayed ledger fields in all nine rows and the exact object-level invariants.",
      "locator": "paper/manuscript.tex#tab:registered-core-ledger",
      "authority": "results/EXPERIMENT_RESULTS.json plus independent result review",
      "status": "FINITE_FALSIFICATION_ONLY",
