{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_counters": {
      "additionalProperties": false,
      "properties": {
        "denied_cross_track_read_count": {"const": 0},
        "denied_dynamic_loader_count": {"const": 0},
        "denied_ledger_read_count": {"const": 0},
        "denied_network_count": {"const": 0},
        "denied_outside_read_count": {"const": 0},
        "denied_outside_write_count": {"const": 0},
        "denied_process_count": {"const": 0},
        "denied_review_read_count": {"const": 0},
        "denied_source_read_count": {"const": 0},
        "run_science_call_count": {"const": 1},
        "successful_outside_read_count": {"const": 0},
        "successful_outside_write_count": {"const": 0}
      },
      "required": [
        "denied_cross_track_read_count",
        "denied_dynamic_loader_count",
        "denied_ledger_read_count",
        "denied_network_count",
        "denied_outside_read_count",
        "denied_outside_write_count",
        "denied_process_count",
        "denied_review_read_count",
        "denied_source_read_count",
        "run_science_call_count",
        "successful_outside_read_count",
        "successful_outside_write_count"
      ],
      "type": "object"
    },
    "access_log_canonical_json": {"minLength": 2, "type": "string"},
    "access_log_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "candidate_id": {"const": "henon_primitive_cycle_cover_v1"},
    "capability_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "certificate_canonical_json": {"minLength": 2, "type": "string"},
    "certificate_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "definitions_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "engine_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "fixture_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "claim_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "runner_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schema": {"const": "P13_BOUNDED_EXACT_TRACK_ENVELOPE_V1"},
    "track": {"enum": ["Q", "R"]}
  },
  "required": [
    "access_counters",
    "access_log_canonical_json",
    "access_log_sha256",
    "candidate_id",
    "capability_sha256",
    "certificate_canonical_json",
    "certificate_sha256",
    "definitions_sha256",
    "engine_sha256",
    "fixture_sha256",
    "claim_sha256",
    "runner_sha256",
    "schema",
    "track"
  ],
  "title": "Paper 13 bounded exact track-envelope types",
  "type": "object"
}
