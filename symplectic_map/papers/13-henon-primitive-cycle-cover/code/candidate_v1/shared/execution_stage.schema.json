{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {"const": 1},
    "candidate_id": {"const": "henon_primitive_cycle_cover_v1"},
    "candidate_version": {"const": 1},
    "claim_path": {"const": "runtime/candidate_v1/official/durable_claim.json"},
    "claim_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "rerun_budget": {"const": 0},
    "run_id": {"const": "R100"},
    "schema": {"const": "P13_EXECUTION_STAGE_V1"},
    "state": {"const": "OPERATION_ENTERED"}
  },
  "required": ["attempt", "candidate_id", "candidate_version", "claim_path", "claim_sha256", "rerun_budget", "run_id", "schema", "state"],
  "title": "Paper 13 one-shot execution-stage boundary",
  "type": "object"
}
