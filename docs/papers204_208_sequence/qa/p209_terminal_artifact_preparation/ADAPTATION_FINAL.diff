+def stripped_links(content):
+    content = re.sub(r'(?ms)^[ ]{0,3}(`{3,}|~{3,})[^\n]*\n.*?^[ ]{0,3}\1[ \t]*$', '\n\n', content)
+    content = re.sub(r'(?:\A|\n\n)(?:(?: {4}|\t)[^\n]*(?:\n|$))+', '\n\n', content)
+    content = re.sub(r'(`+)(?:(?!\1)[\s\S])*?\1', ' ', content)
+    return re.findall(r'\[[^\]]*\]\(([^)]+)\)', content)
