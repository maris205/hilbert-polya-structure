"></path></g><g stroke-width="1.2pt"><path style="fill:none" d="M -52.03 -46.03 L -69.55 7.92"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.96pt" transform="matrix(0.30902 -0.95105 0.95105 0.30902 -52.03 -46.03)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g><g stroke-width="1.2pt"><path style="fill:none" d="M -59.85 35.26 L -13.96 68.6"></path></g></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.96pt" transform="matrix(-0.80902 -0.58778 0.58778 -0.80902 -59.85 35.26)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g></g></svg></span>
