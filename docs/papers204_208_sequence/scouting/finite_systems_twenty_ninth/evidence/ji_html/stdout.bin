"0.96pt" transform="matrix(-0.94868 0.31622 -0.31622 -0.94868 99.2 -6.82)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.2 177.09)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F8.pic4.1" class="ltx_text" style="font-size:90%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -184.3 -4.01)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F8.pic4.2" class="ltx_text" style="font-size:90%;">0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.2 -185.12)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F8.pic4.3" class="ltx_text" style="font-size:90%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 75.54 23.55)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F8.pic4.4" class="ltx_text" style="font-size:90%;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 154.28 23.55)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F8.pic4.5" class="ltx_text" style="font-size:90%;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 114.91 -70.94)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F8.pic4.6" class="ltx_text" style="font-size:90%;">0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 193.65 -70.94)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F8.pic4.7" class="ltx_text" style="font-size:90%;">0</span></span></span></foreignObject></g></g></svg></span>
</span></div></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 8: </span>A parallel chip-firing game in which <math id="S4.F8.m3" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> has atomic firing sequence <math id="S4.F8.m4" class="ltx_Math" alttext="1010" display="inline" intent=":literal"><semantics><mn>1010</mn><annotation encoding="application/x-tex">1010</annotation></semantics></math>.</figcaption>
</figure>
</section>
<section id="S5" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5 </span>Future Directions</h3>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In <a href="#S3.Thmtheorem10" title="Theorem 3.10. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.10</span></a>, we provided a lower bound for the maximum period of a parallel chip-firing game on an orientation of <math id="S5.p1.m1" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> that is asymptotic to <math id="S5.p1.m2" class="ltx_Math" alttext="(n-1)!" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><annotation encoding="application/x-tex">(n-1)!</annotation></semantics></math>. Similarly, in <a href="#S3.Thmtheorem15" title="Theorem 3.15. ‣ 3.4 Complete Bipartite Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.15</span></a>, we showed that the maximum period of a parallel chip-firing game on an orientation of <math id="S5.p1.m3" class="ltx_Math" alttext="K_{a,\,b}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo rspace="0.337em">,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">K_{a,\,b}</annotation></semantics></math> with <math id="S5.p1.m4" class="ltx_Math" alttext="a\leq b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≤</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a\leq b</annotation></semantics></math> is at least asymptotic to <math id="S5.p1.m5" class="ltx_Math" alttext="a!" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>!</mo></mrow><annotation encoding="application/x-tex">a!</annotation></semantics></math>. More challenging is the complete characterization of the possible periods of parallel chip-firing games on orientations of <math id="S5.p1.m6" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> or <math id="S5.p1.m7" class="ltx_Math" alttext="K_{a,\,b}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo rspace="0.337em">,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">K_{a,\,b}</annotation></semantics></math>. In particular, we conjectured in Conjectures <a href="#S3.Thmtheorem8" title="Conjecture 3.8. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.8</span></a> and <a href="#S3.Thmtheorem13" title="Conjecture 3.13. ‣ 3.4 Complete Bipartite Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.13</span></a> that <math id="S5.p1.m8" class="ltx_Math" alttext="\tau(n)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(n)</annotation></semantics></math> and <math id="S5.p1.m9" class="ltx_Math" alttext="\tau(a,\,b)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(a,\,b)</annotation></semantics></math> are indeed asymptotic to <math id="S5.p1.m10" class="ltx_Math" alttext="(n-1)!" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><annotation encoding="application/x-tex">(n-1)!</annotation></semantics></math> and <math id="S5.p1.m11" class="ltx_Math" alttext="a!" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>!</mo></mrow><annotation encoding="application/x-tex">a!</annotation></semantics></math>, respectively. Finally, we conjecture that <math id="S5.p1.m12" class="ltx_Math" alttext="\lim_{c\to\infty}T_{c}(D)" display="inline" intent=":literal"><semantics><mrow><msub><mo>lim</mo><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lim_{c\to\infty}T_{c}(D)</annotation></semantics></math> is finite and well-defined for all directed graphs <math id="S5.p1.m13" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>.</p>
</div>
<div id="S5.Thmtheorem1" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S5.Thmtheorem1.2" class="ltx_text ltx_font_bold">Conjecture 5.1</span></span><span id="S5.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S5.Thmtheorem1.p1" class="ltx_para">
<p id="S5.Thmtheorem1.p1.1" class="ltx_p">For any directed graph <math id="S5.Thmtheorem1.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, the quantity <math id="S5.Thmtheorem1.p1.m2" class="ltx_Math" alttext="T_{c}(D)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{c}(D)</annotation></semantics></math> is stable for very large <math id="S5.Thmtheorem1.p1.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>. That is, there exists some <math id="S5.Thmtheorem1.p1.m4" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> and <math id="S5.Thmtheorem1.p1.m5" class="ltx_Math" alttext="c_{0}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mn>0</mn></msub><annotation encoding="application/x-tex">c_{0}</annotation></semantics></math> such that <math id="S5.Thmtheorem1.p1.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> is a possible period of any parallel chip-firing game on <math id="S5.Thmtheorem1.p1.m7" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> with <math id="S5.Thmtheorem1.p1.m8" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> chips for all <math id="S5.Thmtheorem1.p1.m9" class="ltx_Math" alttext="c\geq c_{0}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>≥</mo><msub><mi>c</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">c\geq c_{0}</annotation></semantics></math>.</p>
</div>
</div>
<div id="S5.p2" class="ltx_para">
<p id="S5.p2.1" class="ltx_p">For the useful orientations of complete and complete bipartite graphs, we conjecture also that <math id="S5.p2.m1" class="ltx_Math" alttext="\lim_{c\to\infty}T_{c}(D)=T_{c^{\prime}}(D)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>lim</mo><mrow><mi>c</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></msub><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>T</mi><msup><mi>c</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\lim_{c\to\infty}T_{c}(D)=T_{c^{\prime}}(D)</annotation></semantics></math>, where <math id="S5.p2.m2" class="ltx_Math" alttext="c^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>c</mi><mo>′</mo></msup><annotation encoding="application/x-tex">c^{\prime}</annotation></semantics></math> are the specific values of <math id="S5.p2.m3" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> defined in Theorems <a href="#S3.Thmtheorem10" title="Theorem 3.10. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.10</span></a> and <a href="#S3.Thmtheorem15" title="Theorem 3.15. ‣ 3.4 Complete Bipartite Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.15</span></a>.</p>
</div>
<section id="S5.SS0.SSSx1" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">Acknowledgements</h5>

<div id="S5.SS0.SSSx1.p1" class="ltx_para">
<p id="S5.SS0.SSSx1.p1.1" class="ltx_p">We thank Yunseo Choi for her endless support, for inspiring this project, and for connecting us through our work.</p>
</div>
</section>
<section id="S5.SS0.SSSx2" class="ltx_subsubsection">
<h5 class="ltx_title ltx_title_subsubsection">Data Availability</h5>

<div id="S5.SS0.SSSx2.p1" class="ltx_para">
<p id="S5.SS0.SSSx2.p1.1" class="ltx_p">No new data were created or analysed. Data sharing is not applicable to this paper.</p>
</div>
<section id="S5.SS0.SSSx2.1" class="ltx_appendix">
<section id="S6" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">6 </span><math id="S6.m1" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math> Games on Undirected Graphs</h3>

<div id="S6.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S6.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma 6.1</span></span><span id="S6.Thmtheorem1.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S6.Thmtheorem1.p1" class="ltx_para">
<p id="S6.Thmtheorem1.p1.1" class="ltx_p">For any finite, connected, undirected graph <math id="S6.Thmtheorem1.p1.m1" class="ltx_Math" alttext="G=(V,\,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,\,E)</annotation></semantics></math> with <math id="S6.Thmtheorem1.p1.m2" class="ltx_Math" alttext="|V|\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow><mo>≥</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">|V|\geq 2</annotation></semantics></math>, there exists a parallel chip-firing game on <math id="S6.Thmtheorem1.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with <math id="S6.Thmtheorem1.p1.m4" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math>.</p>
</div>
</div>
<div id="S6.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S6.p1" class="ltx_para">
<p id="S6.p1.1" class="ltx_p"><span id="S6.p1.1.1" class="ltx_text">We set up a parallel chip-firing game on <math id="S6.p1.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> in the following manner. We arbitrarily choose a vertex <math id="S6.p1.m2" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math> and place <math id="S6.p1.m3" class="ltx_Math" alttext="\deg v" display="inline" intent=":literal"><semantics><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">\deg v</annotation></semantics></math> chips onto it. For all other vertices <math id="S6.p1.m4" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>, we use the following process.</span></p>
<ul id="S6.I1" class="ltx_itemize">
<li id="S6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I1.i1.p1" class="ltx_para">
<p id="S6.I1.i1.p1.1" class="ltx_p">If <math id="S6.I1.i1.p1.m1" class="ltx_Math" alttext="d(u,\,v)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(u,\,v)</annotation></semantics></math> is even, we place <math id="S6.I1.i1.p1.m2" class="ltx_Math" alttext="\deg u" display="inline" intent=":literal"><semantics><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi>u</mi></mrow><annotation encoding="application/x-tex">\deg u</annotation></semantics></math> chips onto <math id="S6.I1.i1.p1.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>.</p>
</div></li>
<li id="S6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S6.I1.i2.p1" class="ltx_para">
<p id="S6.I1.i2.p1.1" class="ltx_p">If <math id="S6.I1.i2.p1.m1" class="ltx_Math" alttext="d(u,\,v)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(u,\,v)</annotation></semantics></math> is odd, we place <math id="S6.I1.i2.p1.m2" class="ltx_Math" alttext="\deg u-n" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi>u</mi></mrow><mo>−</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">\deg u-n</annotation></semantics></math> chips onto <math id="S6.I1.i2.p1.m3" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>, where <math id="S6.I1.i2.p1.m4" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> is the number of edges <math id="S6.I1.i2.p1.m5" class="ltx_Math" alttext="(u,\,w)\in E" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">(u,\,w)\in E</annotation></semantics></math> such that <math id="S6.I1.i2.p1.m6" class="ltx_Math" alttext="d(u,\,v)\neq d(w,\,v)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d(u,\,v)\neq d(w,\,v)</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S6.p2" class="ltx_para">
<p id="S6.p2.1" class="ltx_p"><span id="S6.p2.1.1" class="ltx_text">On the first round of the game, a vertex <math id="S6.p2.m1" class="ltx_Math" alttext="\nu" display="inline" intent=":literal"><semantics><mi>ν</mi><annotation encoding="application/x-tex">\nu</annotation></semantics></math> fires if and only if <math id="S6.p2.m2" class="ltx_Math" alttext="d(\nu,\,v)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ν</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(\nu,\,v)</annotation></semantics></math> is even. On the second round, all vertices that previously fired have lost chips and thus wait. However, the vertices that previously waited now have exactly enough chips to fire. Thus, all vertices fire exactly once in the first two rounds. By <a href="#S3.Thmtheorem6" title="Lemma 3.6 (( , , Proposition 2.5)). ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.6</span></a>, <math id="S6.p2.m3" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
</section>
</section>
</section>
