2.67 -87.97 30.14 -95.44 39.37 -95.44 C 48.6 -95.44 56.07 -87.97 56.07 -78.74 Z M 39.37 -78.74"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 35.91 -83.2)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic1.3" class="ltx_text">3</span></span></span></foreignObject></g><path style="fill:none" d="M 134.81 -78.74 C 134.81 -69.51 127.34 -62.04 118.11 -62.04 C 108.88 -62.04 101.41 -69.51 101.41 -78.74 C 101.41 -87.97 108.88 -95.44 118.11 -95.44 C 127.34 -95.44 134.81 -87.97 134.81 -78.74 Z M 118.11 -78.74"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 114.65 -83.2)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic1.4" class="ltx_text">4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.2 23.55)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic1.5" class="ltx_text" style="font-size:90%;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 75.54 23.55)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic1.6" class="ltx_text" style="font-size:90%;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 36.17 -55.19)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic1.7" class="ltx_text" style="font-size:90%;">0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 114.91 -55.19)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic1.8" class="ltx_text" style="font-size:90%;">0</span></span></span></foreignObject></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 17.26 0 L 57.05 0"></path><g transform="matrix(1.0 0.0 0.0 1.0 57.05 0)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 71.02 -15.44 L 49.07 -59.34"></path><g transform="matrix(-0.4472 -0.89442 0.89442 -0.4472 49.07 -59.34)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 86.46 -15.44 L 108.41 -59.34"></path><g transform="matrix(0.4472 -0.89442 0.89442 0.4472 108.41 -59.34)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 31.65 -63.3 L 9.7 -19.4"></path><g transform="matrix(-0.4472 0.89442 -0.89442 -0.4472 9.7 -19.4)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 103.75 -69.17 L 18.04 -12.03"></path><g transform="matrix(-0.83205 0.5547 -0.5547 -0.83205 18.04 -12.03)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g></g></svg></span></div><div class="ltx_flex_cell ltx_flex_size_2"><span class="ltx_inline-block"><svg id="S4.F6.pic2" class="ltx_picture ltx_centering ltx_figure_panel" height="139.74" overflow="visible" version="1.1" viewBox="0 0 152.63 139.74" width="152.63"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.4pt" transform="translate(0,139.74) matrix(1 0 0 -1 0 0) translate(17.26,0) translate(0,96)"><g stroke-width="0.8pt"><path style="fill:none" d="M 16.7 0 C 16.7 9.23 9.23 16.7 0 16.7 C -9.23 16.7 -16.7 9.23 -16.7 0 C -16.7 -9.23 -9.23 -16.7 0 -16.7 C 9.23 -16.7 16.7 -9.23 16.7 0 Z M 0 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.46 -4.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.1" class="ltx_text">1</span></span></span></foreignObject></g><path style="fill:none" d="M 95.44 0 C 95.44 9.23 87.97 16.7 78.74 16.7 C 69.51 16.7 62.04 9.23 62.04 0 C 62.04 -9.23 69.51 -16.7 78.74 -16.7 C 87.97 -16.7 95.44 -9.23 95.44 0 Z M 78.74 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 75.28 -4.46)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.2" class="ltx_text">2</span></span></span></foreignObject></g><path style="fill:none" d="M 56.07 -78.74 C 56.07 -69.51 48.6 -62.04 39.37 -62.04 C 30.14 -62.04 22.67 -69.51 22.67 -78.74 C 22.67 -87.97 30.14 -95.44 39.37 -95.44 C 48.6 -95.44 56.07 -87.97 56.07 -78.74 Z M 39.37 -78.74"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 35.91 -83.2)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.3" class="ltx_text">3</span></span></span></foreignObject></g><path style="fill:none" d="M 134.81 -78.74 C 134.81 -69.51 127.34 -62.04 118.11 -62.04 C 108.88 -62.04 101.41 -69.51 101.41 -78.74 C 101.41 -87.97 108.88 -95.44 118.11 -95.44 C 127.34 -95.44 134.81 -87.97 134.81 -78.74 Z M 118.11 -78.74"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 114.65 -83.2)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.4" class="ltx_text">4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -3.2 23.55)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.5" class="ltx_text" style="font-size:90%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 75.54 23.55)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.6" class="ltx_text" style="font-size:90%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 36.17 -55.19)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.7" class="ltx_text" style="font-size:90%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 114.91 -55.19)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.63em;--ltx-fo-depth:0em;font-size:9.25pt;" height="8.03" overflow="visible" transform="matrix(1 0 0 -1 0 8.03)" width="6.4"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F6.pic2.8" class="ltx_text" style="font-size:90%;">1</span></span></span></foreignObject></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 17.26 0 L 57.05 0"></path><g transform="matrix(1.0 0.0 0.0 1.0 57.05 0)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 71.02 -15.44 L 49.07 -59.34"></path><g transform="matrix(-0.4472 -0.89442 0.89442 -0.4472 49.07 -59.34)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 86.46 -15.44 L 108.41 -59.34"></path><g transform="matrix(0.4472 -0.89442 0.89442 0.4472 108.41 -59.34)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 31.65 -63.3 L 9.7 -19.4"></path><g transform="matrix(-0.4472 0.89442 -0.89442 -0.4472 9.7 -19.4)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g><g stroke-width="1.2pt"><path style="fill:none" d="M 103.75 -69.17 L 18.04 -12.03"></path><g transform="matrix(-0.83205 0.5547 -0.5547 -0.83205 18.04 -12.03)"><path style="stroke:none" d="M 4.43 0 L -2.66 3.54 L 0 0 L -2.66 -3.54"></path></g></g></g></svg></span></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 6: </span>The final parallel chip-firing game from <a href="#S4.Thmtheorem2" title="Lemma 4.2. ‣ 4 Atomic Firing Sequences ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.2</span></a>. Vertex 1 has atomic firing sequence <math id="S4.F6.m2" class="ltx_Math" alttext="11" display="inline" intent=":literal"><semantics><mn>11</mn><annotation encoding="application/x-tex">11</annotation></semantics></math>.</figcaption>
</figure>
<div id="S4.p7" class="ltx_para">
<p id="S4.p7.1" class="ltx_p"><a href="#S4.Thmtheorem2" title="Lemma 4.2. ‣ 4 Atomic Firing Sequences ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">4.2</span></a> concerns very short binary strings, for which our main theorem does not hold. However, all longer binary strings that contain at least one 1 can also be the atomic firing sequences of a vertex in a parallel chip-firing game on a directed graph. The following lemma constructs a parallel chip-firing game on a directed cycle in which a vertex has an arbitrary binary string <math id="S4.p7.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> of length <math id="S4.p7.m2" class="ltx_Math" alttext="\ell\geq 3" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\ell\geq 3</annotation></semantics></math> as its length-<math id="S4.p7.m3" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> firing sequence.</p>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p">For any binary string <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> of length <math id="S4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\ell\geq 3" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>≥</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\ell\geq 3</annotation></semantics></math>, there exists a parallel chip-firing game on a directed graph such that a vertex <math id="S4.Thmtheorem3.p1.m3" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> has <math id="S4.Thmtheorem3.p1.m4" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> as its length-<math id="S4.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> firing sequence. If <math id="S4.Thmtheorem3.p1.m6" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is not periodic, the atomic firing sequence of <math id="S4.Thmtheorem3.p1.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is its length-<math id="S4.Thmtheorem3.p1.m8" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> firing sequence.</p>
</div>
</div>
<div id="S4.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S4.p8" class="ltx_para">
<p id="S4.p8.1" class="ltx_p"><span id="S4.p8.1.1" class="ltx_text">Consider the simple cycle <math id="S4.p8.m1" class="ltx_Math" alttext="C_{\ell}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi mathvariant="normal">ℓ</mi></msub><annotation encoding="application/x-tex">C_{\ell}</annotation></semantics></math>. Let <math id="S4.p8.m2" class="ltx_Math" alttext="c_{0}(v_{i})=s_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>s</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">c_{0}(v_{i})=s_{i}</annotation></semantics></math>. On each round, all vertices with a chip fire, so the chips shift one vertex along the cycle. Therefore, <math id="S4.p8.m3" class="ltx_Math" alttext="c_{t}(v_{0})=s_{t}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>s</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">c_{t}(v_{0})=s_{t}</annotation></semantics></math>. Since <math id="S4.p8.m4" class="ltx_Math" alttext="c_{t}(v_{0})=F_{t}(v_{0})" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{t}(v_{0})=F_{t}(v_{0})</annotation></semantics></math>, we have that <math id="S4.p8.m5" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is the length-<math id="S4.p8.m6" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> firing sequence of <math id="S4.p8.m7" class="ltx_Math" alttext="v_{0}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>0</mn></msub><annotation encoding="application/x-tex">v_{0}</annotation></semantics></math>.</span></p>
</div>
<div id="S4.p9" class="ltx_para">
<p id="S4.p9.1" class="ltx_p"><span id="S4.p9.1.1" class="ltx_text">Note that if <math id="S4.p9.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> is not periodic, the first round <math id="S4.p9.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> where <math id="S4.p9.m3" class="ltx_Math" alttext="c_{T}(v_{i})=c_{0}(v_{i})=s_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>s</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">c_{T}(v_{i})=c_{0}(v_{i})=s_{i}</annotation></semantics></math> is <math id="S4.p9.m4" class="ltx_Math" alttext="T=\ell" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mi mathvariant="normal">ℓ</mi></mrow><annotation encoding="application/x-tex">T=\ell</annotation></semantics></math>. In this case, the atomic firing sequence of <math id="S4.p9.m5" class="ltx_Math" alttext="v_{0}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>0</mn></msub><annotation encoding="application/x-tex">v_{0}</annotation></semantics></math> is its length-<math id="S4.p9.m6" class="ltx_Math" alttext="\ell" display="inline" intent=":literal"><semantics><mi mathvariant="normal">ℓ</mi><annotation encoding="application/x-tex">\ell</annotation></semantics></math> firing sequence <math id="S4.p9.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Example 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p">In Figure <a href="#S4.F7" title="Figure 7 ‣ 4 Atomic Firing Sequences ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a>, <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="q^{0}=s=11000=c_{0}(v_{1})c_{0}(v_{2})c_{0}(v_{3})c_{0}(v_{4})c_{0}(v_{5})" display="inline" intent=":literal"><semantics><mrow><msup><mi>q</mi><mn>0</mn></msup><mo>=</mo><mi>s</mi><mo>=</mo><mn>11000</mn><mo>=</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">q^{0}=s=11000=c_{0}(v_{1})c_{0}(v_{2})c_{0}(v_{3})c_{0}(v_{4})c_{0}(v_{5})</annotation></semantics></math>. Since <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="s=11000" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>=</mo><mn>11000</mn></mrow><annotation encoding="application/x-tex">s=11000</annotation></semantics></math> is not periodic, <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="T=5" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">T=5</annotation></semantics></math>.</p>
</div>
</div>
