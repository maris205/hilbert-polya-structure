 0.0 0.0 1.0 179.55 -4.73)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="34.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.10" class="ltx_text">SCC2</span></span></span></foreignObject></g><path style="fill:none" d="M 175.41 39.37 C 175.41 49.27 167.38 57.3 157.48 57.3 C 147.58 57.3 139.55 49.27 139.55 39.37 C 139.55 29.47 147.58 21.44 157.48 21.44 C 167.38 21.44 175.41 29.47 175.41 39.37 Z M 157.48 39.37"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 140.18 34.64)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="34.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.11" class="ltx_text">SCC3</span></span></span></foreignObject></g><path style="fill:none" d="M 136.31 0 L 178.01 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(1.0 0.0 0.0 1.0 178.01 0)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><path style="fill:none" d="M 130.98 12.87 L 144.16 26.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(0.7071 0.7071 -0.7071 0.7071 144.16 26.05)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><path style="fill:none" d="M 183.98 12.87 L 170.8 26.05"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-0.7071 0.7071 -0.7071 -0.7071 170.8 26.05)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -203.69 -42.83)"><foreignObject style="--ltx-fo-width:6.68em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="92.42"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.12" class="ltx_text">Original Graph</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 116.32 -44.17)"><foreignObject style="--ltx-fo-width:5.95em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="82.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.13" class="ltx_text">Condensation</span></span></span></foreignObject></g></g></svg></span>
</span></p>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2: </span>A directed graph (left) with strongly connected components boxed and its condensation (right).</figcaption>
</figure>
<div id="S2.p4" class="ltx_para">
<p id="S2.p4.1" class="ltx_p">Prisner <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib9" title="" class="ltx_ref">Prisner (1994)</a></cite> found that only sink components are relevant to the behavior of parallel chip-firing games on a directed graph.</p>
</div>
<div id="S2.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition 2.1</span></span><span id="S2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">(<a href="#bib.bib9" title="" class="ltx_ref">Prisner, 1994</a>, Proposition 2.2)</cite>)<span id="S2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem1.p1" class="ltx_para">
<p id="S2.Thmtheorem1.p1.1" class="ltx_p">In every round <math id="S2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="t\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t\geq 0</annotation></semantics></math> in a parallel chip-firing game on <math id="S2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, all vertices in nonsink components are forever passive.</p>
</div>
</div>
<div id="S2.p5" class="ltx_para">
<p id="S2.p5.1" class="ltx_p">By <a href="#S2.Thmtheorem1" title="Proposition 2.1 (( , , Proposition 2.2)). ‣ 2 Preliminaries ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">2.1</span></a>, in any parallel chip-firing game on a directed graph with multiple sink components, the number of chips in each sink component is eventually fixed. The game can then be considered a superposition of independent parallel chip-firing games on each sink component. In this paper, we will therefore assume that all graphs are strongly connected (i.e. the only sink component of a graph <math id="S2.p5.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is <math id="S2.p5.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> itself) unless otherwise stated. We first prove that no vertices are forever passive in any parallel chip-firing game on a strongly connected directed graph.</p>
</div>
<div id="S2.Thmtheorem2" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Lemma 2.2</span></span><span id="S2.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S2.Thmtheorem2.p1" class="ltx_para">
<p id="S2.Thmtheorem2.p1.1" class="ltx_p">In any parallel chip-firing game on a strongly connected directed graph <math id="S2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> with <math id="S2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="T&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T&gt;1</annotation></semantics></math>, no vertices are forever passive.</p>
</div>
</div>
<div id="S2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S2.p6" class="ltx_para">
<p id="S2.p6.1" class="ltx_p"><span id="S2.p6.1.1" class="ltx_text">As <math id="S2.p6.m1" class="ltx_Math" alttext="T&gt;1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T&gt;1</annotation></semantics></math>, at least one vertex <math id="S2.p6.m2" class="ltx_Math" alttext="v^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>′</mo></msup><annotation encoding="application/x-tex">v^{\prime}</annotation></semantics></math> must fire in each period. Since <math id="S2.p6.m3" class="ltx_Math" alttext="c_{0}(v)=c_{T}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{0}(v)=c_{T}(v)</annotation></semantics></math> for all <math id="S2.p6.m4" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>, each of the vertices which <math id="S2.p6.m5" class="ltx_Math" alttext="v^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>′</mo></msup><annotation encoding="application/x-tex">v^{\prime}</annotation></semantics></math> fires to must also fire in each period. Similarly, all the vertices that are distance 2 from <math id="S2.p6.m6" class="ltx_Math" alttext="v^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>′</mo></msup><annotation encoding="application/x-tex">v^{\prime}</annotation></semantics></math> must fire in each period. In general, every vertex <math id="S2.p6.m7" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> for which there exists a directed path from <math id="S2.p6.m8" class="ltx_Math" alttext="v^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>v</mi><mo>′</mo></msup><annotation encoding="application/x-tex">v^{\prime}</annotation></semantics></math> to <math id="S2.p6.m9" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> must fire in each period. Since <math id="S2.p6.m10" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is strongly connected, such a path exists to any vertex <math id="S2.p6.m11" class="ltx_Math" alttext="u\in V" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">u\in V</annotation></semantics></math>. Thus, all vertices fire at least once in each period.
∎</span></p>
</div>
</div>
</section>
<section id="S3" class="ltx_section">
<h3 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">3 </span>Period Lengths of Parallel Chip-Firing Games</h3>

<section id="S3.SS1" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.1 </span>Trees</h4>

<div id="S3.SS1.p1" class="ltx_para">
<p id="S3.SS1.p1.1" class="ltx_p">The possible periods of parallel chip-firing games on directed trees were identified by Prisner <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib9" title="" class="ltx_ref">Prisner (1994)</a></cite>. We begin by citing his result.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem1.2" class="ltx_text ltx_font_bold">Proposition 3.1</span></span><span id="S3.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">(<a href="#bib.bib9" title="" class="ltx_ref">Prisner, 1994</a>, Corollary 2.3)</cite>)<span id="S3.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p"><math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math> for all parallel chip-firing games on directed acyclic graphs.</p>
</div>
</div>
<div id="S3.SS1.p2" class="ltx_para">
<p id="S3.SS1.p2.1" class="ltx_p">For completeness, we state the following direct corollaries of <a href="#S3.Thmtheorem1" title="Proposition 3.1 (( , , Corollary 2.3)). ‣ 3.1 Trees ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Proposition</span> <span class="ltx_text ltx_ref_tag">3.1</span></a>.</p>
</div>
<div id="S3.Thmtheorem2" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem2.2" class="ltx_text ltx_font_bold">Corollary 3.2</span></span><span id="S3.Thmtheorem2.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem2.p1" class="ltx_para">
<p id="S3.Thmtheorem2.p1.1" class="ltx_p"><math id="S3.Thmtheorem2.p1.m1" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math> for all parallel chip-firing games on directed paths.</p>
</div>
</div>
<div id="S3.Thmtheorem3" class="ltx_theorem ltx_theorem_corollary">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem3.2" class="ltx_text ltx_font_bold">Corollary 3.3</span></span><span id="S3.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem3.p1" class="ltx_para">
<p id="S3.Thmtheorem3.p1.1" class="ltx_p"><math id="S3.Thmtheorem3.p1.m1" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math> for all parallel chip-firing games on directed non-path trees.</p>
</div>
</div>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Cycles</h4>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">Consider the simple directed cycle <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math>. We label the vertices of the cycle <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="v_{0},v_{1},v_{2},\dots,v_{n-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>,</mo><msub><mi>v</mi><mn>1</mn></msub><mo>,</mo><msub><mi>v</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>v</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">v_{0},v_{1},v_{2},\dots,v_{n-1}</annotation></semantics></math> such that there exists an edge directed from <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="v_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{i+1}</annotation></semantics></math> to <math id="S3.SS2.p1.m4" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> for all <math id="S3.SS2.p1.m5" class="ltx_Math" alttext="0\leq i\leq n-1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">0\leq i\leq n-1</annotation></semantics></math>, with indices taken modulo <math id="S3.SS2.p1.m6" class="ltx_Math" alttext="n." display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">n.</annotation></semantics></math> We first show that if any vertex ever has more than 1 chip, the period of the game is 1.</p>
</div>
<div id="S3.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma 3.4</span></span><span id="S3.Thmtheorem4.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem4.p1" class="ltx_para">
<p id="S3.Thmtheorem4.p1.1" class="ltx_p">In a parallel chip-firing game on <math id="S3.Thmtheorem4.p1.m1" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math>, if <math id="S3.Thmtheorem4.p1.m2" class="ltx_Math" alttext="c_{t}(v)&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c_{t}(v)&gt;1</annotation></semantics></math> for any <math id="S3.Thmtheorem4.p1.m3" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math>, then <math id="S3.Thmtheorem4.p1.m4" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p"><span id="S3.SS2.p2.1.1" class="ltx_text">Suppose <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="c_{t}(v_{0})&gt;1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c_{t}(v_{0})&gt;1</annotation></semantics></math>. Note that if <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="c_{t}(v)\geq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c_{t}(v)\geq 1</annotation></semantics></math> then <math id="S3.SS2.p2.m3" class="ltx_Math" alttext="c_{t+1}(v)\leq c_{t}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{t+1}(v)\leq c_{t}(v)</annotation></semantics></math>, so we must have <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="1&lt;c_{t}(v_{0})=c_{t+1}(v_{0})=\dots=c_{t+T-1}(v_{0})=c_{t+T}(v_{0})" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>&lt;</mo><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi mathvariant="normal">⋯</mi><mo>=</mo><mrow><msub><mi>c</mi><mrow><mrow><mi>t</mi><mo>+</mo><mi>T</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mrow><mi>t</mi><mo>+</mo><mi>T</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">1&lt;c_{t}(v_{0})=c_{t+1}(v_{0})=\dots=c_{t+T-1}(v_{0})=c_{t+T}(v_{0})</annotation></semantics></math>. We conclude that <math id="S3.SS2.p2.m5" class="ltx_Math" alttext="v_{0}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>0</mn></msub><annotation encoding="application/x-tex">v_{0}</annotation></semantics></math> must fire on every round and so <math id="S3.SS2.p2.m6" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> must fire on every round as well. By induction, we conclude that every vertex fires on every round, so <math id="S3.SS2.p2.m7" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">We now prove our main theorem about directed cycles.</p>
</div>
<div id="S3.Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem 3.5</span></span><span id="S3.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem5.p1" class="ltx_para">
<p id="S3.Thmtheorem5.p1.1" class="ltx_p">The possible periods <math id="S3.Thmtheorem5.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> of a parallel chip-firing game on <math id="S3.Thmtheorem5.p1.m2" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math> are <math id="S3.Thmtheorem5.p1.m3" class="ltx_Math" alttext="T=i" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">T=i</annotation></semantics></math> for all <math id="S3.Thmtheorem5.p1.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> such that <math id="S3.Thmtheorem5.p1.m5" class="ltx_Math" alttext="i\;|\;n." display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo fence="false" lspace="0.558em">|</mo><mi>n</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">i\;|\;n.</annotation></semantics></math></p>
</div>
</div>
<div id="S3.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.p4" class="ltx_para">
<p id="S3.SS2.p4.1" class="ltx_p"><span id="S3.SS2.p4.1.1" class="ltx_text">Consider a parallel chip-firing game on <math id="S3.SS2.p4.m1" class="ltx_Math" alttext="C_{n}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mi>n</mi></msub><annotation encoding="application/x-tex">C_{n}</annotation></semantics></math> with period <math id="S3.SS2.p4.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>. If <math id="S3.SS2.p4.m3" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math>, we have <math id="S3.SS2.p4.m4" class="ltx_Math" alttext="T\;|\;n" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo fence="false" lspace="0.558em">|</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">T\;|\;n</annotation></semantics></math>. Otherwise, by <a href="#S3.Thmtheorem4" title="Lemma 3.4. ‣ 3.2 Cycles ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.4</span></a>, we have <math id="S3.SS2.p4.m5" class="ltx_Math" alttext="c_{t}(v)\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c_{t}(v)\leq 1</annotation></semantics></math> for all <math id="S3.SS2.p4.m6" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and <math id="S3.SS2.p4.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. We conclude that <math id="S3.SS2.p4.m8" class="ltx_Math" alttext="c_{t}(v)=F_{t}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{t}(v)=F_{t}(v)</annotation></semantics></math> for all <math id="S3.SS2.p4.m9" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and <math id="S3.SS2.p4.m10" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS2.p5" class="ltx_para">
<p id="S3.SS2.p5.1" class="ltx_p"><span id="S3.SS2.p5.1.1" class="ltx_text">Note that if <math id="S3.SS2.p5.m1" class="ltx_Math" alttext="F_{t}(v_{i})=1," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F_{t}(v_{i})=1,</annotation></semantics></math> then <math id="S3.SS2.p5.m2" class="ltx_Math" alttext="v_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{i-1}</annotation></semantics></math> has one chip after round <math id="S3.SS2.p5.m3" class="ltx_Math" alttext="t," display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">t,</annotation></semantics></math> so <math id="S3.SS2.p5.m4" class="ltx_Math" alttext="F_{t+1}(v_{i-1})=1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{t+1}(v_{i-1})=1.</annotation></semantics></math> Thus, if <math id="S3.SS2.p5.m5" class="ltx_Math" alttext="F_{t}(v)=1," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F_{t}(v)=1,</annotation></semantics></math> then <math id="S3.SS2.p5.m6" class="ltx_Math" alttext="F_{t+n}(v)=1." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo>+</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">F_{t+n}(v)=1.</annotation></semantics></math> Additionally, if <math id="S3.SS2.p5.m7" class="ltx_Math" alttext="F_{t+n}(v)=1," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo>+</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F_{t+n}(v)=1,</annotation></semantics></math> then <math id="S3.SS2.p5.m8" class="ltx_Math" alttext="F_{t+nT}(v)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo>+</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>T</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">F_{t+nT}(v)=1</annotation></semantics></math>, and by the definition of a period, <math id="S3.SS2.p5.m9" class="ltx_Math" alttext="F_{t}(v)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">F_{t}(v)=1</annotation></semantics></math> as well. Therefore, <math id="S3.SS2.p5.m10" class="ltx_Math" alttext="F_{t}(v)=F_{t+n}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>F</mi><mrow><mi>t</mi><mo>+</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{t}(v)=F_{t+n}(v)</annotation></semantics></math> for all <math id="S3.SS2.p5.m11" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and <math id="S3.SS2.p5.m12" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, so <math id="S3.SS2.p5.m13" class="ltx_Math" alttext="c_{t}(v)=c_{t+n}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mrow><mi>t</mi><mo>+</mo><mi>n</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{t}(v)=c_{t+n}(v)</annotation></semantics></math> for all <math id="S3.SS2.p5.m14" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and <math id="S3.SS2.p5.m15" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>. Thus, we must have <math id="S3.SS2.p5.m16" class="ltx_Math" alttext="T\;|\;n." display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo fence="false" lspace="0.558em">|</mo><mi>n</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T\;|\;n.</annotation></semantics></math></span></p>
</div>
<div id="S3.SS2.p6" class="ltx_para">
<p id="S3.SS2.p6.1" class="ltx_p"><span id="S3.SS2.p6.1.1" class="ltx_text">To construct a parallel chip-firing game with period <math id="S3.SS2.p6.m1" class="ltx_Math" alttext="T=i" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">T=i</annotation></semantics></math> for any <math id="S3.SS2.p6.m2" class="ltx_Math" alttext="i\;|\;n," display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo fence="false" lspace="0.558em">|</mo><mi>n</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">i\;|\;n,</annotation></semantics></math> place a single chip on each vertex <math id="S3.SS2.p6.m3" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math> that satisfies <math id="S3.SS2.p6.m4" class="ltx_Math" alttext="j\equiv 0\pmod{i}" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>≡</mo><mrow><mn>0</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">j\equiv 0\pmod{i}</annotation></semantics></math>. On round <math id="S3.SS2.p6.m5" class="ltx_Math" alttext="t," display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">t,</annotation></semantics></math> there will be a chip on each vertex <math id="S3.SS2.p6.m6" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math> that satisfies <math id="S3.SS2.p6.m7" class="ltx_Math" alttext="j\equiv-t\pmod{i}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>≡</mo><mrow><mrow><mo>−</mo><mi>t</mi></mrow><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mi>i</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">j\equiv-t\pmod{i}.</annotation></semantics></math> The smallest <math id="S3.SS2.p6.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> for which <math id="S3.SS2.p6.m9" class="ltx_Math" alttext="c_{v}(t)=c_{v}(t+T)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>+</mo><mi>T</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{v}(t)=c_{v}(t+T)</annotation></semantics></math> is therefore <math id="S3.SS2.p6.m10" class="ltx_Math" alttext="T=i" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mi>i</mi></mrow><annotation encoding="application/x-tex">T=i</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Complete Graphs</h4>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">We first note as a surprising aside that while there exists a parallel chip-firing game on any undirected graph with <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math>, it is possible for there to be no orientations of a graph that allow for a parallel chip-firing game with <math id="S3.SS3.p1.m2" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math>. We begin by citing a lemma from Jiang <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib4" title="" class="ltx_ref">Jiang (2010)</a></cite>.</p>
</div>
<div id="S3.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma 3.6</span></span><span id="S3.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_cite">(<a href="#bib.bib4" title="" class="ltx_ref">Jiang, 2010</a>, Proposition 2.5)</cite>)<span id="S3.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem6.p1" class="ltx_para">
<p id="S3.Thmtheorem6.p1.1" class="ltx_p">For any parallel chip-firing game on an undirected graph, <math id="S3.Thmtheorem6.p1.m1" class="ltx_Math" alttext="c_{T}(v)=c_{0}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>T</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>c</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">c_{T}(v)=c_{0}(v)</annotation></semantics></math> for all <math id="S3.Thmtheorem6.p1.m2" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math> if and only if <math id="S3.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\sum_{t=0}^{T-1}F_{t}(v)" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></msubsup><mrow><msub><mi>F</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{t=0}^{T-1}F_{t}(v)</annotation></semantics></math> is constant for all <math id="S3.Thmtheorem6.p1.m4" class="ltx_Math" alttext="v\in V" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow><annotation encoding="application/x-tex">v\in V</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p">In <a href="#S6.Thmtheorem1" title="Lemma 6.1. ‣ 6 𝑇=2 Games on Undirected Graphs ‣ Data Availability ‣ 5 Future Directions ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">6.1</span></a>, we show that there exists a parallel chip-firing game on any undirected graph <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> such that every vertex fires exactly once in the first 2 rounds. However, parallel chip-firing games on directed graphs behave differently, as demonstrated by the following lemma.</p>
</div>
<div id="S3.Thmtheorem7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem7.2" class="ltx_text ltx_font_bold">Lemma 3.7</span></span><span id="S3.Thmtheorem7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem7.p1" class="ltx_para">
<p id="S3.Thmtheorem7.p1.1" class="ltx_p">No parallel chip-firing games on any orientation of <math id="S3.Thmtheorem7.p1.m1" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> with <math id="S3.Thmtheorem7.p1.m2" class="ltx_Math" alttext="n\leq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\leq 4</annotation></semantics></math> have <math id="S3.Thmtheorem7.p1.m3" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.p3" class="ltx_para">
<p id="S3.SS3.p3.1" class="ltx_p"><span id="S3.SS3.p3.1.1" class="ltx_text">Note that <math id="S3.SS3.p3.m1" class="ltx_Math" alttext="K_{2}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>2</mn></msub><annotation encoding="application/x-tex">K_{2}</annotation></semantics></math> is a path, and <math id="S3.SS3.p3.m2" class="ltx_Math" alttext="K_{3}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>3</mn></msub><annotation encoding="application/x-tex">K_{3}</annotation></semantics></math> is a cycle. For these cases, see <a href="#S3.Thmtheorem2" title="Corollary 3.2. ‣ 3.1 Trees ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Corollary</span> <span class="ltx_text ltx_ref_tag">3.2</span></a> and <a href="#S3.Thmtheorem5" title="Theorem 3.5. ‣ 3.2 Cycles ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Theorem</span> <span class="ltx_text ltx_ref_tag">3.5</span></a>, respectively. Then consider a parallel chip-firing game on a strongly connected orientation <math id="S3.SS3.p3.m3" class="ltx_Math" alttext="D=(V,\,E)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D=(V,\,E)</annotation></semantics></math> of <math id="S3.SS3.p3.m4" class="ltx_Math" alttext="K_{4}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>4</mn></msub><annotation encoding="application/x-tex">K_{4}</annotation></semantics></math> with <math id="S3.SS3.p3.m5" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math>. Recall that because <math id="S3.SS3.p3.m6" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> is strongly connected, each vertex <math id="S3.SS3.p3.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> in <math id="S3.SS3.p3.m8" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> must satisfy <math id="S3.SS3.p3.m9" class="ltx_Math" alttext="\deg^{+}v&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\deg^{+}v&gt;0</annotation></semantics></math> and <math id="S3.SS3.p3.m10" class="ltx_Math" alttext="\deg^{-}v&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>−</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\deg^{-}v&gt;0</annotation></semantics></math>. Also, by Lemma <a href="#S2.Thmtheorem2" title="Lemma 2.2. ‣ 2 Preliminaries ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2.2</span></a>, each vertex must fire at least once in each period.</span></p>
</div>
<div id="S3.SS3.p4" class="ltx_para">
<p id="S3.SS3.p4.1" class="ltx_p"><span id="S3.SS3.p4.1.1" class="ltx_text">Since <math id="S3.SS3.p4.m1" class="ltx_Math" alttext="\deg v=3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>deg</mi><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>=</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">\deg v=3</annotation></semantics></math>, <math id="S3.SS3.p4.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> must be one of two types: <math id="S3.SS3.p4.m3" class="ltx_Math" alttext="\deg^{-}v=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>−</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg^{-}v=1</annotation></semantics></math> and <math id="S3.SS3.p4.m4" class="ltx_Math" alttext="\deg^{+}v=2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\deg^{+}v=2</annotation></semantics></math>, or <math id="S3.SS3.p4.m5" class="ltx_Math" alttext="\deg^{-}v=2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>−</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\deg^{-}v=2</annotation></semantics></math> and <math id="S3.SS3.p4.m6" class="ltx_Math" alttext="\deg^{+}v=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg^{+}v=1</annotation></semantics></math>. Additionally, since <math id="S3.SS3.p4.m7" class="ltx_Math" alttext="\sum_{v\in V}\deg^{-}v=\sum_{v\in V}\deg^{+}v" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></msub><mrow><msup><mi>deg</mi><mo>−</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>v</mi><mo>∈</mo><mi>V</mi></mrow></msub><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{v\in V}\deg^{-}v=\sum_{v\in V}\deg^{+}v</annotation></semantics></math>, there must be two vertices of each type. Let <math id="S3.SS3.p4.m8" class="ltx_Math" alttext="\deg^{+}v_{1}=\deg^{+}v_{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><msub><mi>v</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg^{+}v_{1}=\deg^{+}v_{2}=1</annotation></semantics></math>, and let <math id="S3.SS3.p4.m9" class="ltx_Math" alttext="\deg^{+}u_{1}=\deg^{+}u_{2}=2" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><msub><mi>u</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><msub><mi>u</mi><mn>2</mn></msub></mrow><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\deg^{+}u_{1}=\deg^{+}u_{2}=2</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS3.p5" class="ltx_para">
<p id="S3.SS3.p5.1" class="ltx_p"><span id="S3.SS3.p5.1.1" class="ltx_text">Note that there must exist an edge between <math id="S3.SS3.p5.m1" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> and <math id="S3.SS3.p5.m2" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math> and that regardless of its direction, one of the two vertices must view it as its single out-edge. Thus, there is only one edge directed from <math id="S3.SS3.p5.m3" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> or <math id="S3.SS3.p5.m4" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math> to <math id="S3.SS3.p5.m5" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math> or <math id="S3.SS3.p5.m6" class="ltx_Math" alttext="u_{2}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>2</mn></msub><annotation encoding="application/x-tex">u_{2}</annotation></semantics></math>. Without loss of generality, let it be directed from <math id="S3.SS3.p5.m7" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> to <math id="S3.SS3.p5.m8" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math>. On the other hand, there are three edges directed from <math id="S3.SS3.p5.m9" class="ltx_Math" alttext="u_{1}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>1</mn></msub><annotation encoding="application/x-tex">u_{1}</annotation></semantics></math> or <math id="S3.SS3.p5.m10" class="ltx_Math" alttext="u_{2}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mn>2</mn></msub><annotation encoding="application/x-tex">u_{2}</annotation></semantics></math> to <math id="S3.SS3.p5.m11" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> or <math id="S3.SS3.p5.m12" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS3.p6" class="ltx_para">
<p id="S3.SS3.p6.1" class="ltx_p"><span id="S3.SS3.p6.1.1" class="ltx_text">Since <math id="S3.SS3.p6.m1" class="ltx_Math" alttext="T=2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T=2</annotation></semantics></math>, we must have <math id="S3.SS3.p6.m2" class="ltx_Math" alttext="f_{v_{1}}\leq 2" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msub><mi>v</mi><mn>1</mn></msub></msub><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">f_{v_{1}}\leq 2</annotation></semantics></math>. However, <math id="S3.SS3.p6.m3" class="ltx_Math" alttext="f_{u_{1}}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msub><mi>u</mi><mn>1</mn></msub></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">f_{u_{1}}\geq 1</annotation></semantics></math> and <math id="S3.SS3.p6.m4" class="ltx_Math" alttext="f_{u_{2}}\geq 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><msub><mi>u</mi><mn>2</mn></msub></msub><mo>≥</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">f_{u_{2}}\geq 1</annotation></semantics></math>. Then there must be at most two chips that travel from a vertex in <math id="S3.SS3.p6.m5" class="ltx_Math" alttext="V=\{v_{1},\,v_{2}\}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>v</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">V=\{v_{1},\,v_{2}\}</annotation></semantics></math> to one in <math id="S3.SS3.p6.m6" class="ltx_Math" alttext="U=\{u_{1},\,u_{2}\}" display="inline" intent=":literal"><semantics><mrow><mi>U</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>u</mi><mn>2</mn></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">U=\{u_{1},\,u_{2}\}</annotation></semantics></math>, but at least three chips that travel from a vertex in <math id="S3.SS3.p6.m7" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> to one in <math id="S3.SS3.p6.m8" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>. It is impossible for every vertex to have the same number of chips after 2 rounds, so <math id="S3.SS3.p6.m9" class="ltx_Math" alttext="T\neq 2" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≠</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">T\neq 2</annotation></semantics></math> for all parallel chip-firing games on <math id="S3.SS3.p6.m10" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS3.p7" class="ltx_para">
<p id="S3.SS3.p7.1" class="ltx_p">Next, let <math id="S3.SS3.p7.m1" class="ltx_Math" alttext="\tau(n)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(n)</annotation></semantics></math> be the maximum possible period of a parallel chip-firing game on an orientation of <math id="S3.SS3.p7.m2" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math>. We show that <math id="S3.SS3.p7.m3" class="ltx_Math" alttext="\tau(n)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(n)</annotation></semantics></math> is at least asymptotic to <math id="S3.SS3.p7.m4" class="ltx_Math" alttext="(n-1)!" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><annotation encoding="application/x-tex">(n-1)!</annotation></semantics></math>. We conjecture that <math id="S3.SS3.p7.m5" class="ltx_Math" alttext="\tau(n)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(n)</annotation></semantics></math> is indeed asymptotic to <math id="S3.SS3.p7.m6" class="ltx_Math" alttext="(n-1)!" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><annotation encoding="application/x-tex">(n-1)!</annotation></semantics></math></p>
</div>
<div id="S3.Thmtheorem8" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem8.2" class="ltx_text ltx_font_bold">Conjecture 3.8</span></span><span id="S3.Thmtheorem8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem8.p1" class="ltx_para">
<p id="S3.Thmtheorem8.p1.1" class="ltx_p">It holds that <math id="S3.Thmtheorem8.p1.m1" class="ltx_Math" alttext="\tau(n)=\Theta((n-1)!)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(n)=\Theta((n-1)!)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS3.p8" class="ltx_para">
<p id="S3.SS3.p8.1" class="ltx_p">We define the following orientation of <math id="S3.SS3.p8.m1" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> with vertices <math id="S3.SS3.p8.m2" class="ltx_Math" alttext="v_{1},\,v_{2},\,\ldots,\,v_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>v</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>v</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">v_{1},\,v_{2},\,\ldots,\,v_{n}</annotation></semantics></math> to be a <em id="S3.SS3.p8.1.1" class="ltx_emph ltx_font_italic">useful</em> orientation.</p>
<ul id="S3.I1" class="ltx_itemize">
<li id="S3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i1.p1" class="ltx_para">
<p id="S3.I1.i1.p1.1" class="ltx_p">There exist edges directed from <math id="S3.I1.i1.p1.m1" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> to <math id="S3.I1.i1.p1.m2" class="ltx_Math" alttext="v_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{i+1}</annotation></semantics></math> for each <math id="S3.I1.i1.p1.m3" class="ltx_Math" alttext="1\leq i&lt;n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq i&lt;n</annotation></semantics></math>, and there exists an edge directed from <math id="S3.I1.i1.p1.m4" class="ltx_Math" alttext="v_{n}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>n</mi></msub><annotation encoding="application/x-tex">v_{n}</annotation></semantics></math> to <math id="S3.I1.i1.p1.m5" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i2.p1" class="ltx_para">
<p id="S3.I1.i2.p1.1" class="ltx_p">There exist edges directed from <math id="S3.I1.i2.p1.m1" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> to every other vertex except <math id="S3.I1.i2.p1.m2" class="ltx_Math" alttext="v_{n}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>n</mi></msub><annotation encoding="application/x-tex">v_{n}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I1.i3.p1" class="ltx_para">
<p id="S3.I1.i3.p1.1" class="ltx_p">There exist edges directed from <math id="S3.I1.i3.p1.m1" class="ltx_Math" alttext="v_{j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>j</mi></msub><annotation encoding="application/x-tex">v_{j}</annotation></semantics></math> to all vertices <math id="S3.I1.i3.p1.m2" class="ltx_Math" alttext="v_{k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>k</mi></msub><annotation encoding="application/x-tex">v_{k}</annotation></semantics></math> with <math id="S3.I1.i3.p1.m3" class="ltx_Math" alttext="1&lt;k\leq j-2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>&lt;</mo><mi>k</mi><mo>≤</mo><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1&lt;k\leq j-2</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S3.SS3.p9" class="ltx_para">
<p id="S3.SS3.p9.1" class="ltx_p">See Figure <a href="#S3.F3" title="Figure 3 ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> for a diagram of a useful orientation of <math id="S3.SS3.p9.m1" class="ltx_Math" alttext="K_{5}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>5</mn></msub><annotation encoding="application/x-tex">K_{5}</annotation></semantics></math>. Unless otherwise stated, all future references of <math id="S3.SS3.p9.m2" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> will refer specifically to the useful orientation of <math id="S3.SS3.p9.m3" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math>.</p>
</div>
<figure id="S3.F3" class="ltx_figure"><span class="ltx_inline-block"><svg id="S3.F3.pic1" class="ltx_picture ltx_centering" height="167.17" overflow="visible" version="1.1" viewBox="0 0 174.5 167.17" width="174.5"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,167.17) matrix(1 0 0 -1 0 0) translate(87.25,0) translate(0,76.07)"><g stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8pt"><path style="fill:none" d="M 11.81 78.74 C 11.81 85.26 6.52 90.55 0 90.55 C -6.52 90.55 -11.81 85.26 -11.81 78.74 C -11.81 72.22 -6.52 66.93 0 66.93 C 6.52 66.93 11.81 72.22 11.81 78.74 Z M 0 78.74"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 75.17)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.1" class="ltx_text" style="font-size:80%;">1</span></span></span></foreignObject></g><path style="fill:none" d="M -63.08 24.33 C -63.08 30.86 -68.36 36.14 -74.89 36.14 C -81.41 36.14 -86.7 30.86 -86.7 24.33 C -86.7 17.81 -81.41 12.52 -74.89 12.52 C -68.36 12.52 -63.08 17.81 -63.08 24.33 Z M -74.89 24.33"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -77.83 20.77)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.2" class="ltx_text" style="font-size:80%;">5</span></span></span></foreignObject></g><path style="fill:none" d="M -34.47 -63.7 C -34.47 -57.18 -