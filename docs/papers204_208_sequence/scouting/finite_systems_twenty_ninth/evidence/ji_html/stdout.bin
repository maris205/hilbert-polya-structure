_foreignobject_content"><span id="S3.F4.pic4.2" class="ltx_text" style="font-size:80%;">2</span></span></span></foreignObject></g><path style="fill:none" d="M 70.87 0 C 70.87 6.52 65.58 11.81 59.06 11.81 C 52.53 11.81 47.24 6.52 47.24 0 C 47.24 -6.52 52.53 -11.81 59.06 -11.81 C 65.58 -11.81 70.87 -6.52 70.87 0 Z M 59.06 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.11 -3.57)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic4.3" class="ltx_text" style="font-size:80%;">3</span></span></span></foreignObject></g><path style="fill:none" d="M 11.81 0 C 11.81 6.52 6.52 11.81 0 11.81 C -6.52 11.81 -11.81 6.52 -11.81 0 C -11.81 -6.52 -6.52 -11.81 0 -11.81 C 6.52 -11.81 11.81 -6.52 11.81 0 Z M 0 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 -3.57)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic4.4" class="ltx_text" style="font-size:80%;">4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 75.17)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic4.5" class="ltx_text" style="font-size:80%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.11 75.17)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic4.6" class="ltx_text" style="font-size:80%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.11 -23.25)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic4.7" class="ltx_text" style="font-size:80%;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 -23.25)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic4.8" class="ltx_text" style="font-size:80%;">1</span></span></span></foreignObject></g><path style="fill:none" d="M 12.36 59.06 L 45.71 59.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 45.71 59.06)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 59.06 46.69 L 59.06 13.35"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.0 -1.0 1.0 0.0 59.06 13.35)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 46.69 0 L 13.35 0"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-1.0 0.0 0.0 -1.0 13.35 0)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 0 12.36 L 0 45.71"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.0 1.0 -1.0 0.0 0 45.71)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 8.74 50.31 L 49.62 9.44"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.7071 -0.7071 0.7071 0.7071 49.62 9.44)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 8.74 8.74 L 49.62 49.62"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.7071 0.7071 -0.7071 0.7071 49.62 49.62)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g></g></svg></span>
</span></div></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 4: </span>An example of a parallel chip-firing game on <math id="S3.F4.m3" class="ltx_Math" alttext="K_{4}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>4</mn></msub><annotation encoding="application/x-tex">K_{4}</annotation></semantics></math> with <math id="S3.F4.m4" class="ltx_Math" alttext="T=T_{4}=4" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><msub><mi>T</mi><mn>4</mn></msub><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">T=T_{4}=4</annotation></semantics></math>.</figcaption>
</figure>
<div id="S3.Thmtheorem12" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem12.2" class="ltx_text ltx_font_bold">Remark 3.12</span></span><span id="S3.Thmtheorem12.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem12.p1" class="ltx_para">
<p id="S3.Thmtheorem12.p1.1" class="ltx_p">Matrix <a href="#S3.E3" title="Equation 3.3 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a> is extremely similar to the out-degree Laplacian matrix of <math id="S3.Thmtheorem12.p1.m1" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math>. In fact, the matrix representation of System <a href="#S3.E1" title="Equation 3.1 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> is exactly the out-degree Laplacian. The concept of using the out-degree Laplacian of a directed graph <math id="S3.Thmtheorem12.p1.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> to analyze the periods of parallel chip-firing games on <math id="S3.Thmtheorem12.p1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> was previously mentioned by Prisner <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib9" title="" class="ltx_ref">Prisner (1994)</a></cite>, though the method of Gauss-Jordan Elimination is novel in the context of chip-firing games.</p>
</div>
</div>
</section>
<section id="S3.SS4" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.4 </span>Complete Bipartite Graphs</h4>

<div id="S3.SS4.p1" class="ltx_para">
<p id="S3.SS4.p1.1" class="ltx_p">Let <math id="S3.SS4.p1.m1" class="ltx_Math" alttext="\tau(a,\,b)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(a,\,b)</annotation></semantics></math> be the maximum possible period of a parallel chip-firing game on an orientation of <math id="S3.SS4.p1.m2" class="ltx_Math" alttext="K_{a,\,b}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo rspace="0.337em">,</mo><mi>b</mi></mrow></msub><annotation encoding="application/x-tex">K_{a,\,b}</annotation></semantics></math>, with <math id="S3.SS4.p1.m3" class="ltx_Math" alttext="a\leq b" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>≤</mo><mi>b</mi></mrow><annotation encoding="application/x-tex">a\leq b</annotation></semantics></math>. We show that <math id="S3.SS4.p1.m4" class="ltx_Math" alttext="\tau(a,\,b)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(a,\,b)</annotation></semantics></math> is at least asymptotic to <math id="S3.SS4.p1.m5" class="ltx_Math" alttext="a!" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>!</mo></mrow><annotation encoding="application/x-tex">a!</annotation></semantics></math>. We conjecture that <math id="S3.SS4.p1.m6" class="ltx_Math" alttext="\tau(a,\,b)" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\tau(a,\,b)</annotation></semantics></math> is indeed asymptotic to <math id="S3.SS4.p1.m7" class="ltx_Math" alttext="a!" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>!</mo></mrow><annotation encoding="application/x-tex">a!</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem13" class="ltx_theorem ltx_theorem_conjecture">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem13.2" class="ltx_text ltx_font_bold">Conjecture 3.13</span></span><span id="S3.Thmtheorem13.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem13.p1" class="ltx_para">
<p id="S3.Thmtheorem13.p1.1" class="ltx_p">It holds that <math id="S3.Thmtheorem13.p1.m1" class="ltx_Math" alttext="\tau(a,\,b)=\Theta(a!)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>τ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>a</mi><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\tau(a,\,b)=\Theta(a!)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS4.p2" class="ltx_para">
<p id="S3.SS4.p2.1" class="ltx_p">Let the partitions of the complete bipartite graph <math id="S3.SS4.p2.m1" class="ltx_Math" alttext="K_{a,\,a}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo rspace="0.337em">,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">K_{a,\,a}</annotation></semantics></math> be <math id="S3.SS4.p2.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> and <math id="S3.SS4.p2.m3" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, where <math id="S3.SS4.p2.m4" class="ltx_Math" alttext="|L|=|R|=a" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi>L</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><mo stretchy="false">|</mo><mi>R</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">|L|=|R|=a</annotation></semantics></math>. Let <math id="S3.SS4.p2.m5" class="ltx_Math" alttext="v_{i}\in L" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∈</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">v_{i}\in L</annotation></semantics></math> if <math id="S3.SS4.p2.m6" class="ltx_Math" alttext="i\equiv 1\pmod{2}" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≡</mo><mrow><mn>1</mn><mspace style="width:0.949em;" width="0.949em"></mspace><mrow><mo stretchy="false">(</mo><mrow><mo lspace="0em" rspace="0.167em">mod</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\equiv 1\pmod{2}</annotation></semantics></math>, and let <math id="S3.SS4.p2.m7" class="ltx_Math" alttext="v_{i}\in R" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∈</mo><mi>R</mi></mrow><annotation encoding="application/x-tex">v_{i}\in R</annotation></semantics></math> otherwise. We define the following orientation of <math id="S3.SS4.p2.m8" class="ltx_Math" alttext="K_{a,a}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo>,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">K_{a,a}</annotation></semantics></math> to be a <span id="S3.SS4.p2.1.1" class="ltx_text ltx_font_italic">useful</span> orientation.</p>
</div>
<div id="S3.SS4.p3" class="ltx_para">
<ul id="S3.I2" class="ltx_itemize">
<li id="S3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i1.p1" class="ltx_para">
<p id="S3.I2.i1.p1.1" class="ltx_p">There exist edges directed from <math id="S3.I2.i1.p1.m1" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> to <math id="S3.I2.i1.p1.m2" class="ltx_Math" alttext="v_{i+1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{i+1}</annotation></semantics></math> for each <math id="S3.I2.i1.p1.m3" class="ltx_Math" alttext="1\leq i&lt;n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq i&lt;n</annotation></semantics></math>, and there exists an edge directed from <math id="S3.I2.i1.p1.m4" class="ltx_Math" alttext="v_{2a}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">v_{2a}</annotation></semantics></math> to <math id="S3.I2.i1.p1.m5" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i2.p1" class="ltx_para">
<p id="S3.I2.i2.p1.1" class="ltx_p">There exist edges directed from <math id="S3.I2.i2.p1.m1" class="ltx_Math" alttext="v_{1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>1</mn></msub><annotation encoding="application/x-tex">v_{1}</annotation></semantics></math> to <math id="S3.I2.i2.p1.m2" class="ltx_Math" alttext="v_{2i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow></msub><annotation encoding="application/x-tex">v_{2i}</annotation></semantics></math> for all <math id="S3.I2.i2.p1.m3" class="ltx_Math" alttext="1\leq i&lt;a" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>&lt;</mo><mi>a</mi></mrow><annotation encoding="application/x-tex">1\leq i&lt;a</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i3.p1" class="ltx_para">
<p id="S3.I2.i3.p1.1" class="ltx_p">There exist edges directed from <math id="S3.I2.i3.p1.m1" class="ltx_Math" alttext="v_{2j+1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{2j+1}</annotation></semantics></math> to all vertices <math id="S3.I2.i3.p1.m2" class="ltx_Math" alttext="v_{2k}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><annotation encoding="application/x-tex">v_{2k}</annotation></semantics></math> with <math id="S3.I2.i3.p1.m3" class="ltx_Math" alttext="1\leq k&lt;j" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>k</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">1\leq k&lt;j</annotation></semantics></math>.</p>
</div></li>
<li id="S3.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S3.I2.i4.p1" class="ltx_para">
<p id="S3.I2.i4.p1.1" class="ltx_p">There exist edges directed from <math id="S3.I2.i4.p1.m1" class="ltx_Math" alttext="v_{2j}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><annotation encoding="application/x-tex">v_{2j}</annotation></semantics></math> to all vertices <math id="S3.I2.i4.p1.m2" class="ltx_Math" alttext="v_{2k-1}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">v_{2k-1}</annotation></semantics></math> with <math id="S3.I2.i4.p1.m3" class="ltx_Math" alttext="1&lt;k&lt;j" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>&lt;</mo><mi>k</mi><mo>&lt;</mo><mi>j</mi></mrow><annotation encoding="application/x-tex">1&lt;k&lt;j</annotation></semantics></math>.</p>
</div></li>
</ul>
</div>
<div id="S3.SS4.p4" class="ltx_para">
<p id="S3.SS4.p4.1" class="ltx_p">See Figure <a href="#S3.F5" title="Figure 5 ‣ 3.4 Complete Bipartite Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> for a diagram of a useful orientation of <math id="S3.SS4.p4.m1" class="ltx_Math" alttext="K_{4,\,4}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mn>4</mn><mo>,</mo><mn> 4</mn></mrow></msub><annotation encoding="application/x-tex">K_{4,\,4}</annotation></semantics></math>. Unless otherwise stated, all future mentions of <math id="S3.SS4.p4.m2" class="ltx_Math" alttext="K_{a,\,a}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo rspace="0.337em">,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">K_{a,\,a}</annotation></semantics></math> will refer specifically to the useful orientation of <math id="S3.SS4.p4.m3" class="ltx_Math" alttext="K_{a,\,a}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mrow><mi>a</mi><mo rspace="0.337em">,</mo><mi>a</mi></mrow></msub><annotation encoding="application/x-tex">K_{a,\,a}</annotation></semantics></math>.</p>
</div>
<figure id="S3.F5" class="ltx_figure">
<div id="S3.F5.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:112.2pt;height:154.8pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(18.7pt,-25.8pt) scale(1.5,1.5) ;"><span class="ltx_inline-block"><svg id="S3.F5.pic1" class="ltx_picture" height="142.84" overflow="visible" version="1.1" viewBox="0 0 103.47 142.84" width="103.47"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,142.84) matrix(1 0 0 -1 0 0) translate(12.36,0) translate(0,12.36)"><g stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8pt"><path style="fill:none" d="M 11.81 118.11 C 11.81 124.63 6.52 129.92 0 129.92 C -6.52 129.92 -11.81 124.63 -11.81 118.11 C -11.81 111.59 -6.52 106.3 0 106.3 C 6.52 106.3 11.81 111.59 11.81 118.11 Z M 0 118.11"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 114.54)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F5.pic1.1" class="ltx_text" style="font-size:80%;">1</span></span></span></foreignObject></g><path style="fill:none" d="M 11.81 78.74 C 11.81 85.26 6.52 90.55 0 90.55 C -6.52 90.55 -11.81 85.26 -11.81 78.74 C -11.81 72.22 -6.52 66.93 0 66.93 C 6.52 66.93 11.81 72.22 11.81 78.74 Z M 0 78.74"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 75.17)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobj