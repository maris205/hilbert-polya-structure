 -67.9 10.84 L -9.9 68.84"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.96pt" transform="matrix(-0.7071 -0.7071 0.7071 -0.7071 -67.9 10.84)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g><g stroke-width="1.2pt"><path style="fill:none" d="M 10.84 67.9 L 64.43 14.31"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.96pt" transform="matrix(-0.7071 0.7071 -0.7071 -0.7071 10.84 67.9)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g><g stroke-width="1.2pt"><path style="fill:none" d="M 63.49 -15.25 L 9.9 -68.84"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.96pt" transform="matrix(0.7071 0.7071 -0.7071 0.7071 63.49 -15.25)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g><g stroke-width="1.2pt"><path style="fill:none" d="M -10.84 -107.27 L -108.21 -9.9"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.96pt" transform="matrix(0.7071 -0.7071 0.7071 0.7071 -10.84 -107.27)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g><g stroke-width="1.2pt"><path style="fill:none" d="M -107.27 10.84 L -9.9 108.21"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.96pt" transform="matrix(-0.7071 -0.7071 0.7071 -0.7071 -107.27 10.84)"><path style="fill:none" d="M -2.66 3.54 C -2.44 2.21 0 0.22 0.66 0 C 0 -0.22 -2.44 -2.21 -2.66 -3.54"></path></g><g stroke-width="1.2pt"><path style="fill:none" d="M 8.5 105.35 L 67.51 16.84"></path></g><g stroke-da