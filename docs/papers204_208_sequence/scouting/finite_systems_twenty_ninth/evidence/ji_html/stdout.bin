"ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F3.pic1.5" class="ltx_text" style="font-size:80%;">2</span></span></span></foreignObject></g><path style="fill:none" d="M 10 71.47 L 64.09 32.18"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.80902 -0.58778 0.58778 0.80902 64.09 32.18)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M -70.76 11.64 L -50.1 -51.94"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-0.30902 0.95105 -0.95105 -0.30902 -70.76 11.64)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M -32.94 -63.7 L 33.92 -63.7"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-1.0 0.0 0.0 -1.0 -32.94 -63.7)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 50.41 -51.01 L 71.07 12.57"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-0.30902 -0.95105 0.95105 -0.30902 50.41 -51.01)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M -3.82 66.98 L -42.16 -51.01"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(-0.30902 -0.95107 0.95107 -0.30902 -42.16 -51.01)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 3.82 66.98 L 42.16 -51.01"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.30902 -0.95107 0.95107 0.30902 42.16 -51.01)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 35.48 -55.86 L -64.88 17.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.80902 -0.58778 0.58778 0.80902 35.48 -55.86)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 61.54 24.33 L -62.52 24.33"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 61.54 24.33)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 64.09 16.49 L -36.28 -56.43"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.80902 0.58778 -0.58778 0.80902 64.09 16.49)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M -64.88 31.6 L -10.8 70.9"></path></g><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(0.80902 0.58778 -0.58778 0.80902 -10.8 70.9)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 3: </span>A useful orientation of <math id="S3.F3.m2" class="ltx_Math" alttext="K_{5}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>5</mn></msub><annotation encoding="application/x-tex">K_{5}</annotation></semantics></math>.</figcaption>
</figure>
<div id="S3.SS3.p10" class="ltx_para">
<p id="S3.SS3.p10.1" class="ltx_p">The following lemma shows that vertex 3 fires the most in all parallel chip-firing games on <math id="S3.SS3.p10.m1" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> with <math id="S3.SS3.p10.m2" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math>.</p>
</div>
<div id="S3.Thmtheorem9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem9.2" class="ltx_text ltx_font_bold">Lemma 3.9</span></span><span id="S3.Thmtheorem9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem9.p1" class="ltx_para">
<p id="S3.Thmtheorem9.p1.1" class="ltx_p">For any <math id="S3.Thmtheorem9.p1.m1" class="ltx_Math" alttext="n\geq 4," display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">n\geq 4,</annotation></semantics></math> all parallel chip-firing games on <math id="S3.Thmtheorem9.p1.m2" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math> satisfy <math id="S3.Thmtheorem9.p1.m3" class="ltx_Math" alttext="f_{3}\geq f_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>3</mn></msub><mo>≥</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">f_{3}\geq f_{i}</annotation></semantics></math> for all <math id="S3.Thmtheorem9.p1.m4" class="ltx_Math" alttext="1\leq i\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq i\leq n</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.p11" class="ltx_para">
<p id="S3.SS3.p11.1" class="ltx_p"><span id="S3.SS3.p11.1.1" class="ltx_text">Since <math id="S3.SS3.p11.m1" class="ltx_Math" alttext="\deg^{+}v_{3}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><msub><mi>v</mi><mn>3</mn></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg^{+}v_{3}=1</annotation></semantics></math>, it must fire once in each period for every chip received in that period. Note that <math id="S3.SS3.p11.m2" class="ltx_Math" alttext="v_{3}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>3</mn></msub><annotation encoding="application/x-tex">v_{3}</annotation></semantics></math> receives chips from all other vertices except <math id="S3.SS3.p11.m3" class="ltx_Math" alttext="v_{4}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>4</mn></msub><annotation encoding="application/x-tex">v_{4}</annotation></semantics></math>. Thus, <math id="S3.SS3.p11.m4" class="ltx_Math" alttext="f_{3}\geq f_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>3</mn></msub><mo>≥</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">f_{3}\geq f_{i}</annotation></semantics></math> for all <math id="S3.SS3.p11.m5" class="ltx_Math" alttext="i\neq 4" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>≠</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">i\neq 4</annotation></semantics></math>. Also note that <math id="S3.SS3.p11.m6" class="ltx_Math" alttext="\deg^{+}v_{2}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><msub><mi>v</mi><mn>2</mn></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\deg^{+}v_{2}=1</annotation></semantics></math>, and that <math id="S3.SS3.p11.m7" class="ltx_Math" alttext="v_{2}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>2</mn></msub><annotation encoding="application/x-tex">v_{2}</annotation></semantics></math> receives chips from <math id="S3.SS3.p11.m8" class="ltx_Math" alttext="v_{4}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mn>4</mn></msub><annotation encoding="application/x-tex">v_{4}</annotation></semantics></math>. Then <math id="S3.SS3.p11.m9" class="ltx_Math" alttext="f_{2}\geq f_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>≥</mo><msub><mi>f</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">f_{2}\geq f_{4}</annotation></semantics></math>. Since <math id="S3.SS3.p11.m10" class="ltx_Math" alttext="f_{3}\geq f_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>3</mn></msub><mo>≥</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">f_{3}\geq f_{2}</annotation></semantics></math>, we have <math id="S3.SS3.p11.m11" class="ltx_Math" alttext="f_{3}\geq f_{4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>3</mn></msub><mo>≥</mo><msub><mi>f</mi><mn>4</mn></msub></mrow><annotation encoding="application/x-tex">f_{3}\geq f_{4}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS3.p12" class="ltx_para">
<p id="S3.SS3.p12.1" class="ltx_p">Let the <em id="S3.SS3.p12.1.1" class="ltx_emph ltx_font_italic"><math id="S3.SS3.p12.m1" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>-convergent period</em> <math id="S3.SS3.p12.m2" class="ltx_Math" alttext="T_{c}(G)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">T_{c}(G)</annotation></semantics></math> of a graph <math id="S3.SS3.p12.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> be <math id="S3.SS3.p12.m4" class="ltx_Math" alttext="\min(T)" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\min(T)</annotation></semantics></math> over all parallel chip-firing games on <math id="S3.SS3.p12.m5" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> with at least <math id="S3.SS3.p12.m6" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> chips. Note that <math id="S3.SS3.p12.m7" class="ltx_Math" alttext="T_{c}(G)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T_{c}(G)=1</annotation></semantics></math> for any undirected graph <math id="S3.SS3.p12.m8" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, regardless of <math id="S3.SS3.p12.m9" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib6" title="" class="ltx_ref">Bu et al. (2022)</a></cite>. We will show that the same is not true for directed graphs.</p>
</div>
<div id="S3.Thmtheorem10" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem10.2" class="ltx_text ltx_font_bold">Theorem 3.10</span></span><span id="S3.Thmtheorem10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem10.p1" class="ltx_para">
<p id="S3.Thmtheorem10.p1.1" class="ltx_p">For the useful orientation of <math id="S3.Thmtheorem10.p1.m1" class="ltx_Math" alttext="K_{n}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mi>n</mi></msub><annotation encoding="application/x-tex">K_{n}</annotation></semantics></math>, with <math id="S3.Thmtheorem10.p1.m2" class="ltx_Math" alttext="c=\frac{n(n-3)}{2}+1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mrow><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>+</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">c=\frac{n(n-3)}{2}+1</annotation></semantics></math>, we have <math id="S3.Thmtheorem10.p1.m3" class="ltx_Math" alttext="T_{c}(K_{n})=\Omega((n-1)!)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{c}(K_{n})=\Omega((n-1)!)</annotation></semantics></math>.</p>
</div>
</div>
<div id="S3.SS3.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS3.p13" class="ltx_para">
<p id="S3.SS3.p13.2" class="ltx_p"><span id="S3.SS3.p13.2.1" class="ltx_text">Since the number of chips on each vertex does not change after a full period, the following equations must hold.</span></p>
<table id="S3.E1" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E1X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E1X.m2" class="ltx_Math" alttext="\displaystyle f_{n}=(n-2)f_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>n</mi></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{n}=(n-2)f_{1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="5" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(3.1)</span></td></tr>
<tr id="S3.E1Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E1Xa.m2" class="ltx_Math" alttext="\displaystyle f_{1}+f_{4}+\ldots+f_{n}=f_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>+</mo><msub><mi>f</mi><mn>4</mn></msub><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><msub><mi>f</mi><mi>n</mi></msub></mrow><mo>=</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle f_{1}+f_{4}+\ldots+f_{n}=f_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E1Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E1Xb.m2" class="ltx_Math" alttext="\displaystyle f_{1}+f_{j-1}+f_{j+2}+f_{j+3}+\ldots+f_{n}=(j-2)f_{j}\quad\text{for}\quad 3\leq j\leq n-2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>+</mo><msub><mi>f</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>f</mi><mrow><mi>j</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>+</mo><msub><mi>f</mi><mrow><mi>j</mi><mo>+</mo><mn>3</mn></mrow></msub><mo>+</mo><mi mathvariant="normal">…</mi><mo>+</mo><msub><mi>f</mi><mi>n</mi></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>j</mi></msub></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>for</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mn>3</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{1}+f_{j-1}+f_{j+2}+f_{j+3}+\ldots+f_{n}=(j-2)f_{j}\quad\text{for}\quad 3\leq j\leq n-2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E1Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E1Xc.m2" class="ltx_Math" alttext="\displaystyle f_{1}+f_{n-2}=(n-3)f_{n-1}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>+</mo><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{1}+f_{n-2}=(n-3)f_{n-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E1Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E1Xd.m2" class="ltx_Math" alttext="\displaystyle f_{n-1}=(n-2)f_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>n</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle f_{n-1}=(n-2)f_{n}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p14" class="ltx_para">
<p id="S3.SS3.p14.1" class="ltx_p"><span id="S3.SS3.p14.1.1" class="ltx_text">For any solution, scaling gives a new solution, so System <a href="#S3.E1" title="Equation 3.1 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> is not independent. We arbitrarily drop the first equation, leaving a system of <math id="S3.SS3.p14.m1" class="ltx_Math" alttext="n-1" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">n-1</annotation></semantics></math> independent equations in <math id="S3.SS3.p14.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> variables. These remaining equations are linearly independent, as can be seen later in the un-augmented form of Matrix <a href="#S3.E4" title="Equation 3.4 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a>, whose rank is equal to the number of rows.</span></p>
</div>
<div id="S3.SS3.p15" class="ltx_para">
<p id="S3.SS3.p15.2" class="ltx_p"><span id="S3.SS3.p15.2.1" class="ltx_text">By definition, each of <math id="S3.SS3.p15.m1" class="ltx_Math" alttext="f_{1},f_{2},\ldots,\,f_{n}\geq 0." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><mrow><msub><mi>f</mi><mi>n</mi></msub><mo>≥</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{1},f_{2},\ldots,\,f_{n}\geq 0.</annotation></semantics></math> By <a href="#S2.Thmtheorem2" title="Lemma 2.2. ‣ 2 Preliminaries ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">2.2</span></a>, if any <math id="S3.SS3.p15.m2" class="ltx_Math" alttext="f_{i}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f_{i}=0</annotation></semantics></math>, we have <math id="S3.SS3.p15.m3" class="ltx_Math" alttext="T=1" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T=1</annotation></semantics></math> and all vertices are forever passive. However, the largest possible <math id="S3.SS3.p15.m4" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> for which all vertices can be forever passive is <math id="S3.SS3.p15.m5" class="ltx_Math" alttext="\sum_{v}(\deg^{+}v-1)=|E|-|V|=\frac{n(n-3)}{2}&lt;c" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>v</mi></msub><mrow><mo lspace="0em" stretchy="false">(</mo><mrow><mrow><msup><mi>deg</mi><mo>+</mo></msup><mo lspace="0.167em">⁡</mo><mi>v</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">|</mo><mi>E</mi><mo stretchy="false">|</mo></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>n</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></mfrac><mo>&lt;</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\sum_{v}(\deg^{+}v-1)=|E|-|V|=\frac{n(n-3)}{2}&lt;c</annotation></semantics></math>. Thus, we further constrain <math id="S3.SS3.p15.m6" class="ltx_Math" alttext="f_{i}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">f_{i}&gt;0</annotation></semantics></math> for all <math id="S3.SS3.p15.m7" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Note that for any solution <math id="S3.SS3.p15.m8" class="ltx_Math" alttext="(f_{1},f_{2},\ldots,\,f_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(f_{1},f_{2},\ldots,\,f_{n})</annotation></semantics></math>, it must be true that <math id="S3.SS3.p15.m9" class="ltx_Math" alttext="(\lambda f_{1},\lambda f_{2},\ldots,\,\lambda f_{n})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>1</mn></msub></mrow><mo>,</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mn>2</mn></msub></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>n</mi></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\lambda f_{1},\lambda f_{2},\ldots,\,\lambda f_{n})</annotation></semantics></math> is also a solution. To find the minimal solution, we set <math id="S3.SS3.p15.m10" class="ltx_Math" alttext="f_{1}=1." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>=</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{1}=1.</annotation></semantics></math> System <a href="#S3.E1" title="Equation 3.1 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> has now been reduced to the following.</span></p>
<table id="S3.E2" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="S3.E2X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E2X.m2" class="ltx_Math" alttext="\displaystyle f_{2}-f_{4}-\ldots-f_{n}=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>2</mn></msub><mo>−</mo><msub><mi>f</mi><mn>4</mn></msub><mo>−</mo><mi mathvariant="normal">…</mi><mo>−</mo><msub><mi>f</mi><mi>n</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle f_{2}-f_{4}-\ldots-f_{n}=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(3.2)</span></td></tr>
<tr id="S3.E2Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E2Xa.m2" class="ltx_Math" alttext="\displaystyle-f_{j-1}+(j-2)f_{j}-f_{j+2}-f_{j+3}-\ldots-f_{n}=1\quad\text{for}\quad j:\;3\leq j\leq n-2" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo>−</mo><msub><mi>f</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>j</mi></msub></mrow></mrow><mo>−</mo><msub><mi>f</mi><mrow><mi>j</mi><mo>+</mo><mn>2</mn></mrow></msub><mo>−</mo><msub><mi>f</mi><mrow><mi>j</mi><mo>+</mo><mn>3</mn></mrow></msub><mo>−</mo><mi mathvariant="normal">…</mi><mo>−</mo><msub><mi>f</mi><mi>n</mi></msub></mrow><mo>=</mo><mn>1</mn></mrow><mspace style="width:1em;" width="1em"></mspace><mtext>for</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mi>j</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mn> 3</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-f_{j-1}+(j-2)f_{j}-f_{j+2}-f_{j+3}-\ldots-f_{n}=1\quad\text{for}\quad j:\;3\leq j\leq n-2</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E2Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E2Xb.m2" class="ltx_Math" alttext="\displaystyle-f_{n-2}+(n-3)f_{n-1}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\displaystyle-f_{n-2}+(n-3)f_{n-1}=1</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="S3.E2Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S3.E2Xc.m2" class="ltx_Math" alttext="\displaystyle-f_{n-1}+(n-2)f_{n}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mi>n</mi></msub></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\displaystyle-f_{n-1}+(n-2)f_{n}=0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p16" class="ltx_para">
<p id="S3.SS3.p16.1" class="ltx_p"><span id="S3.SS3.p16.1.1" class="ltx_text">Note that these equations are linearly independent. Therefore, we can let a well-defined <math id="S3.SS3.p16.m1" class="ltx_Math" alttext="T_{n}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mi>n</mi></msub><annotation encoding="application/x-tex">T_{n}</annotation></semantics></math> denote the maximal value of <math id="S3.SS3.p16.m2" class="ltx_Math" alttext="f_{i}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>i</mi></msub><annotation encoding="application/x-tex">f_{i}</annotation></semantics></math> satisfying System <a href="#S3.E2" title="Equation 3.2 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>. By <a href="#S3.Thmtheorem9" title="Lemma 3.9. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.9</span></a>, for any solution with <math id="S3.SS3.p16.m3" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math>, we have <math id="S3.SS3.p16.m4" class="ltx_Math" alttext="f_{3}\geq f_{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>3</mn></msub><mo>≥</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">f_{3}\geq f_{i}</annotation></semantics></math> for all <math id="S3.SS3.p16.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Therefore, <math id="S3.SS3.p16.m6" class="ltx_Math" alttext="T_{n}=f_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><msub><mi>f</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">T_{n}=f_{3}</annotation></semantics></math> if <math id="S3.SS3.p16.m7" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math>. We claim that, for <math id="S3.SS3.p16.m8" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math>,</span></p>
<table id="S3.Ex1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex1.m1" class="ltx_Math" alttext="T_{n}=T_{n-2}+(n-1)T_{n-1}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><mrow><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{n}=T_{n-2}+(n-1)T_{n-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p17" class="ltx_para">
<p id="S3.SS3.p17.1" class="ltx_p"><span id="S3.SS3.p17.1.1" class="ltx_text">System <a href="#S3.E2" title="Equation 3.2 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> can be written as the following augmented matrix <math id="S3.SS3.p17.m1" class="ltx_Math" alttext="M_{n}=(A|B)" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>A</mi><mo lspace="0em" rspace="0em">|</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{n}=(A|B)</annotation></semantics></math>, where <math id="S3.SS3.p17.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> is an <math id="S3.SS3.p17.m3" class="ltx_Math" alttext="(n-1)\times(n-1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(n-1)\times(n-1)</annotation></semantics></math> matrix and <math id="S3.SS3.p17.m4" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is a <math id="S3.SS3.p17.m5" class="ltx_Math" alttext="(n-1)\times 1" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(n-1)\times 1</annotation></semantics></math> column vector. We denote the element in the <math id="S3.SS3.p17.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>th row and <math id="S3.SS3.p17.m7" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>th column as <math id="S3.SS3.p17.m8" class="ltx_Math" alttext="M_{n}^{i,\,j}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mrow><mi>i</mi><mo rspace="0.337em">,</mo><mi>j</mi></mrow></msubsup><annotation encoding="application/x-tex">M_{n}^{i,\,j}</annotation></semantics></math>, where <math id="S3.SS3.p17.m9" class="ltx_Math" alttext="1\leq i\leq n-1" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1\leq i\leq n-1</annotation></semantics></math> and <math id="S3.SS3.p17.m10" class="ltx_Math" alttext="1\leq j\leq n" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>≤</mo><mi>j</mi><mo>≤</mo><mi>n</mi></mrow><annotation encoding="application/x-tex">1\leq j\leq n</annotation></semantics></math>.</span></p>
<table id="S3.E3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E3.m1" class="ltx_Math" alttext="M_{n}=\left(\begin{array}[]{@{}*{9}{c}|c@{}}1&amp;0&amp;-1&amp;-1&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
-1&amp;1&amp;0&amp;-1&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
0&amp;-1&amp;2&amp;0&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
\vdots&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;\vdots\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;-1&amp;n-3&amp;0&amp;1\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;0&amp;-1&amp;n-2&amp;0\end{array}\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_border_r"><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_border_r"><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mn>2</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_border_r"><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd class="ltx_border_r"></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow></mtd><mtd class="ltx_border_r"><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_border_r"><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{n}=\left(\begin{array}[]{@{}*{9}{c}|c@{}}1&amp;0&amp;-1&amp;-1&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
-1&amp;1&amp;0&amp;-1&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
0&amp;-1&amp;2&amp;0&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
\vdots&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;\vdots\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;-1&amp;n-3&amp;0&amp;1\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;0&amp;-1&amp;n-2&amp;0\end{array}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.3)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p18" class="ltx_para">
<p id="S3.SS3.p18.1" class="ltx_p"><span id="S3.SS3.p18.1.1" class="ltx_text">We now apply Gauss-Jordan Elimination to transform <math id="S3.SS3.p18.m1" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> into reduced row echelon form. In particular, we seek the value of <math id="S3.SS3.p18.m2" class="ltx_Math" alttext="T_{n}=f_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><msub><mi>f</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">T_{n}=f_{3}</annotation></semantics></math>. We will denote the reduced row echelon form of <math id="S3.SS3.p18.m3" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> as <math id="S3.SS3.p18.m4" class="ltx_Math" alttext="R_{n}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>n</mi></msub><annotation encoding="application/x-tex">R_{n}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS3.p19" class="ltx_para">
<p id="S3.SS3.p19.1" class="ltx_p"><span id="S3.SS3.p19.1.1" class="ltx_text">We denote the submatrix formed by omitting the last row and column of <math id="S3.SS3.p19.m1" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> as <math id="S3.SS3.p19.m2" class="ltx_Math" alttext="M_{n}[-1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">M_{n}[-1]</annotation></semantics></math>. Note that <math id="S3.SS3.p19.m3" class="ltx_Math" alttext="M_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">M_{n-1}</annotation></semantics></math> is very similar to <math id="S3.SS3.p19.m4" class="ltx_Math" alttext="M_{n}[-1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">M_{n}[-1]</annotation></semantics></math>. In particular, <math id="S3.SS3.p19.m5" class="ltx_Math" alttext="M_{n}[-1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">M_{n}[-1]</annotation></semantics></math> differs from <math id="S3.SS3.p19.m6" class="ltx_Math" alttext="M_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">M_{n-1}</annotation></semantics></math> only in the <math id="S3.SS3.p19.m7" class="ltx_Math" alttext="(n-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-1)</annotation></semantics></math>th column, which is negated. We proceed with the following algorithm.</span></p>
</div>
<div id="S3.SS3.p20" class="ltx_para">
<p id="S3.SS3.p20.1" class="ltx_p"><span id="S3.SS3.p20.1.1" class="ltx_text">We first add each row to the one beneath it, putting <math id="S3.SS3.p20.m1" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> into row echelon form.</span></p>
<table id="S3.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E4.m1" class="ltx_Math" alttext="M_{n}=\left(\begin{array}[]{@{}*{9}{c}|c@{}}1&amp;0&amp;-1&amp;-1&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
0&amp;1&amp;-1&amp;-2&amp;-2&amp;\ldots&amp;-2&amp;-2&amp;-2&amp;2\\
0&amp;0&amp;1&amp;-2&amp;-3&amp;\ldots&amp;-3&amp;-3&amp;-3&amp;3\\
\vdots&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;\vdots\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;0&amp;1&amp;-(n-3)&amp;n-2\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;0&amp;0&amp;1&amp;n-2\end{array}\right)" display="block" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>n</mi></msub><mo>=</mo><mrow><mo>(</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><mn>1</mn></mtd><mtd><mn>0</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd class="ltx_border_r"><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mn>1</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mrow><mo>−</mo><mn>1</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>2</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>2</mn></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mo>−</mo><mn>2</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>2</mn></mrow></mtd><mtd class="ltx_border_r"><mrow><mo>−</mo><mn>2</mn></mrow></mtd><mtd><mn>2</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd><mrow><mo>−</mo><mn>2</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>3</mn></mrow></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mrow><mo>−</mo><mn>3</mn></mrow></mtd><mtd><mrow><mo>−</mo><mn>3</mn></mrow></mtd><mtd class="ltx_border_r"><mrow><mo>−</mo><mn>3</mn></mrow></mtd><mtd><mn>3</mn></mtd></mtr><mtr><mtd><mi mathvariant="normal">⋮</mi></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd></mtd><mtd class="ltx_border_r"></mtd><mtd><mi mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd><mtd class="ltx_border_r"><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mtd><mtd><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mi mathvariant="normal">…</mi></mtd><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd class="ltx_border_r"><mn>1</mn></mtd><mtd><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mtd></mtr></mtable><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">M_{n}=\left(\begin{array}[]{@{}*{9}{c}|c@{}}1&amp;0&amp;-1&amp;-1&amp;-1&amp;\ldots&amp;-1&amp;-1&amp;-1&amp;1\\
0&amp;1&amp;-1&amp;-2&amp;-2&amp;\ldots&amp;-2&amp;-2&amp;-2&amp;2\\
0&amp;0&amp;1&amp;-2&amp;-3&amp;\ldots&amp;-3&amp;-3&amp;-3&amp;3\\
\vdots&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;&amp;\vdots\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;0&amp;1&amp;-(n-3)&amp;n-2\\
0&amp;0&amp;0&amp;0&amp;0&amp;\ldots&amp;0&amp;0&amp;1&amp;n-2\end{array}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(3.4)</span></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p21" class="ltx_para">
<p id="S3.SS3.p21.1" class="ltx_p"><span id="S3.SS3.p21.1.1" class="ltx_text">We next apply the rest of the Gauss-Jordan Elimination algorithm for <math id="S3.SS3.p21.m1" class="ltx_Math" alttext="M_{n-2}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">M_{n-2}</annotation></semantics></math> on <math id="S3.SS3.p21.m2" class="ltx_Math" alttext="M_{n}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mi>n</mi></msub><annotation encoding="application/x-tex">M_{n}</annotation></semantics></math> to create a new matrix <math id="S3.SS3.p21.m3" class="ltx_Math" alttext="M_{n}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">M_{n}^{\prime}</annotation></semantics></math>. The <math id="S3.SS3.p21.m4" class="ltx_Math" alttext="(n-2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-2)</annotation></semantics></math>th and <math id="S3.SS3.p21.m5" class="ltx_Math" alttext="(n-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-1)</annotation></semantics></math>th columns of <math id="S3.SS3.p21.m6" class="ltx_Math" alttext="M_{n}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">M_{n}^{\prime}</annotation></semantics></math> will have arbitrary constants, but the rest of <math id="S3.SS3.p21.m7" class="ltx_Math" alttext="M_{n}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">M_{n}^{\prime}</annotation></semantics></math> will be in reduced row echelon form. In other words, we solve for <math id="S3.SS3.p21.m8" class="ltx_Math" alttext="f_{2},\,\ldots,\,f_{n-2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">f_{2},\,\ldots,\,f_{n-2}</annotation></semantics></math> in terms of <math id="S3.SS3.p21.m9" class="ltx_Math" alttext="f_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">f_{n-1}</annotation></semantics></math> and <math id="S3.SS3.p21.m10" class="ltx_Math" alttext="f_{n}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>n</mi></msub><annotation encoding="application/x-tex">f_{n}</annotation></semantics></math>. Recall that <math id="S3.SS3.p21.m11" class="ltx_Math" alttext="M_{n}^{\prime 2,\,n-2}=-R_{n-2}^{2,\,n-2}=-T_{n-2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mn>2</mn><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mrow></mrow></msubsup><mo>=</mo><mrow><mo>−</mo><msubsup><mi>R</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mrow><mn>2</mn><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mrow></msubsup></mrow><mo>=</mo><mrow><mo>−</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">M_{n}^{\prime 2,\,n-2}=-R_{n-2}^{2,\,n-2}=-T_{n-2}</annotation></semantics></math>. To cancel <math id="S3.SS3.p21.m12" class="ltx_Math" alttext="M_{n}^{\prime 2,\,n-2}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mn>2</mn><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mrow></mrow></msubsup><annotation encoding="application/x-tex">M_{n}^{\prime 2,\,n-2}</annotation></semantics></math>, we note that <math id="S3.SS3.p21.m13" class="ltx_Math" alttext="M_{n}^{\prime n-2,\,n-2}=1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></mrow></mrow></msubsup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M_{n}^{\prime n-2,\,n-2}=1</annotation></semantics></math>. Thus, we add <math id="S3.SS3.p21.m14" class="ltx_Math" alttext="T_{n-2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">T_{n-2}</annotation></semantics></math> times the <math id="S3.SS3.p21.m15" class="ltx_Math" alttext="(n-2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-2)</annotation></semantics></math>th row to the second row, leaving <math id="S3.SS3.p21.m16" class="ltx_Math" alttext="f_{3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mn>3</mn></msub><annotation encoding="application/x-tex">f_{3}</annotation></semantics></math> in terms of only <math id="S3.SS3.p21.m17" class="ltx_Math" alttext="f_{n}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>n</mi></msub><annotation encoding="application/x-tex">f_{n}</annotation></semantics></math>. If <math id="S3.SS3.p21.m18" class="ltx_Math" alttext="M_{n}^{n-2,\,n}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo rspace="0.337em">,</mo><mi>n</mi></mrow></msubsup><annotation encoding="application/x-tex">M_{n}^{n-2,\,n}</annotation></semantics></math> were equal to <math id="S3.SS3.p21.m19" class="ltx_Math" alttext="n-3=M_{n-1}^{n-2,\,n-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>−</mo><mn>3</mn></mrow><mo>=</mo><msubsup><mi>M</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msubsup></mrow><annotation encoding="application/x-tex">n-3=M_{n-1}^{n-2,\,n-1}</annotation></semantics></math>, we would now have that <math id="S3.SS3.p21.m20" class="ltx_Math" alttext="M_{n}^{\prime 2,\,n}=T_{n-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mn>2</mn><mo rspace="0.337em">,</mo><mi>n</mi></mrow></mrow></msubsup><mo>=</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">M_{n}^{\prime 2,\,n}=T_{n-1}</annotation></semantics></math>. However, <math id="S3.SS3.p21.m21" class="ltx_Math" alttext="M_{n}^{n-2,\,n}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo rspace="0.337em">,</mo><mi>n</mi></mrow></msubsup><annotation encoding="application/x-tex">M_{n}^{n-2,\,n}</annotation></semantics></math> is instead <math id="S3.SS3.p21.m22" class="ltx_Math" alttext="M_{n-1}^{n-2,\,n-1}+1" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mrow><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo rspace="0.337em">,</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mrow></msubsup><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M_{n-1}^{n-2,\,n-1}+1</annotation></semantics></math>. Therefore, adding <math id="S3.SS3.p21.m23" class="ltx_Math" alttext="T_{n-2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">T_{n-2}</annotation></semantics></math> times the <math id="S3.SS3.p21.m24" class="ltx_Math" alttext="(n-2)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-2)</annotation></semantics></math>th row to the 2nd row adds an additional quantity of <math id="S3.SS3.p21.m25" class="ltx_Math" alttext="T_{n-2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">T_{n-2}</annotation></semantics></math> to <math id="S3.SS3.p21.m26" class="ltx_Math" alttext="M_{n}^{\prime 2,\,n}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mn>2</mn><mo rspace="0.337em">,</mo><mi>n</mi></mrow></mrow></msubsup><annotation encoding="application/x-tex">M_{n}^{\prime 2,\,n}</annotation></semantics></math>, so that we now have <math id="S3.SS3.p21.m27" class="ltx_Math" alttext="M_{n}^{\prime 2,\,n}=T_{n-2}+T_{n-1}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mn>2</mn><mo rspace="0.337em">,</mo><mi>n</mi></mrow></mrow></msubsup><mo>=</mo><mrow><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>+</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">M_{n}^{\prime 2,\,n}=T_{n-2}+T_{n-1}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS3.p22" class="ltx_para">
<p id="S3.SS3.p22.1" class="ltx_p"><span id="S3.SS3.p22.1.1" class="ltx_text">We now proceed with the rest of the Gauss-Jordan Elimination algorithm for <math id="S3.SS3.p22.m1" class="ltx_Math" alttext="M_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">M_{n-1}</annotation></semantics></math> on <math id="S3.SS3.p22.m2" class="ltx_Math" alttext="M_{n}^{\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mo>′</mo></msubsup><annotation encoding="application/x-tex">M_{n}^{\prime}</annotation></semantics></math> to create a new matrix <math id="S3.SS3.p22.m3" class="ltx_Math" alttext="M_{n}^{\prime\prime}" display="inline" intent=":literal"><semantics><msubsup><mi>M</mi><mi>n</mi><mo>′′</mo></msubsup><annotation encoding="application/x-tex">M_{n}^{\prime\prime}</annotation></semantics></math>, in which only the <math id="S3.SS3.p22.m4" class="ltx_Math" alttext="(n-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-1)</annotation></semantics></math>th column is not in reduced row echelon form. In other words, we solve for <math id="S3.SS3.p22.m5" class="ltx_Math" alttext="f_{2},\,\ldots,\,f_{n-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>2</mn></msub><mo rspace="0.337em">,</mo><mi mathvariant="normal">…</mi><mo rspace="0.337em">,</mo><msub><mi>f</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">f_{2},\,\ldots,\,f_{n-1}</annotation></semantics></math> in terms of <math id="S3.SS3.p22.m6" class="ltx_Math" alttext="f_{n}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>n</mi></msub><annotation encoding="application/x-tex">f_{n}</annotation></semantics></math>. Recall that <math id="S3.SS3.p22.m7" class="ltx_math_unparsed" alttext="M_{n}^{\prime\prime 2,\,n-1}=-T_{n-1}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mn>2</mn><mo rspace="0.337em">,</mo><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mi>T</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">M_{n}^{\prime\prime 2,\,n-1}=-T_{n-1}</annotation></semantics></math>. To cancel <math id="S3.SS3.p22.m8" class="ltx_math_unparsed" alttext="M_{n}^{\prime\prime 2,\,n-1}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mn>2</mn><mo rspace="0.337em">,</mo><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">M_{n}^{\prime\prime 2,\,n-1}</annotation></semantics></math>, we note that <math id="S3.SS3.p22.m9" class="ltx_math_unparsed" alttext="M_{n}^{\prime\prime n-1,\,n-1}=1" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo rspace="0.337em">,</mo><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M_{n}^{\prime\prime n-1,\,n-1}=1</annotation></semantics></math>. Thus, we add <math id="S3.SS3.p22.m10" class="ltx_Math" alttext="T_{n-1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">T_{n-1}</annotation></semantics></math> times the <math id="S3.SS3.p22.m11" class="ltx_Math" alttext="(n-1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n-1)</annotation></semantics></math>th row to the second row, putting the second row completely into reduced row echelon form. Note that <math id="S3.SS3.p22.m12" class="ltx_math_unparsed" alttext="M_{n}^{\prime\prime n-1,\,n}=\sum_{i=1}^{n-1}M_{n}^{i,\,n}=\deg^{+}v_{1}=n-2" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo rspace="0.337em">,</mo><mi>n</mi></mrow></msup><mo rspace="0.111em">=</mo><mo>∑</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msup><mi>M</mi><msub><mrow></mrow><mi>n</mi></msub><msup><mrow></mrow><mrow><mi>i</mi><mo rspace="0.337em">,</mo><mi>n</mi></mrow></msup><mo>=</mo><mi>deg</mi><msup><mrow></mrow><mo>+</mo></msup><mi>v</mi><msub><mrow></mrow><mn>1</mn></msub><mo>=</mo><mi>n</mi><mo>−</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">M_{n}^{\prime\prime n-1,\,n}=\sum_{i=1}^{n-1}M_{n}^{i,\,n}=\deg^{+}v_{1}=n-2</annotation></semantics></math>. Thus,</span></p>
<table id="S3.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex2.m1" class="ltx_math_unparsed" alttext="M_{n}^{\prime\prime 2,\,n}=M_{n}^{\prime 2,\,n}+T_{n-1}(n-2)=T_{n-2}+T_{n-1}+T_{n-1}(n-2)=T_{n-2}+(n-1)T_{n-1}." display="block" intent=":literal"><semantics><mrow><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mo lspace="0em" rspace="0em">′</mo><mn>2</mn><mo rspace="0.337em">,</mo><mi>n</mi></mrow></msubsup><mo>=</mo><msubsup><mi>M</mi><mi>n</mi><mrow><mo rspace="0em">′</mo><mphantom></mphantom><mrow><mn>2</mn><mo rspace="0.337em">,</mo><mi>n</mi></mrow></mrow></msubsup><mo>+</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>+</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M_{n}^{\prime\prime 2,\,n}=M_{n}^{\prime 2,\,n}+T_{n-1}(n-2)=T_{n-2}+T_{n-1}+T_{n-1}(n-2)=T_{n-2}+(n-1)T_{n-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p23" class="ltx_para">
<p id="S3.SS3.p23.1" class="ltx_p"><span id="S3.SS3.p23.1.1" class="ltx_text">Since the second row is now in reduced row echelon form, we have</span></p>
<table id="S3.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex3.m1" class="ltx_Math" alttext="f_{3}=T_{n-2}+(n-1)T_{n-1}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mn>3</mn></msub><mo>=</mo><mrow><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{3}=T_{n-2}+(n-1)T_{n-1}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S3.SS3.p24" class="ltx_para">
<p id="S3.SS3.p24.1" class="ltx_p"><span id="S3.SS3.p24.1.1" class="ltx_text">Since <math id="S3.SS3.p24.m1" class="ltx_Math" alttext="\gcd(f_{1},\,f_{3})=\gcd(1,\,f_{3})=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>gcd</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo rspace="0.337em">,</mo><msub><mi>f</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>gcd</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo rspace="0.337em">,</mo><msub><mi>f</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\gcd(f_{1},\,f_{3})=\gcd(1,\,f_{3})=1</annotation></semantics></math>, we have <math id="S3.SS3.p24.m2" class="ltx_Math" alttext="T_{n}=f_{3}=T_{n-2}+(n-1)T_{n-1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><msub><mi>f</mi><mn>3</mn></msub><mo>=</mo><mrow><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>T</mi><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{n}=f_{3}=T_{n-2}+(n-1)T_{n-1}</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS3.p25" class="ltx_para">
<p id="S3.SS3.p25.1" class="ltx_p"><span id="S3.SS3.p25.1.1" class="ltx_text">For <math id="S3.SS3.p25.m1" class="ltx_Math" alttext="n\leq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\leq 3</annotation></semantics></math>, <a href="#S3.Thmtheorem9" title="Lemma 3.9. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Lemma</span> <span class="ltx_text ltx_ref_tag">3.9</span></a> does not hold. However, we can manually solve System <a href="#S3.E2" title="Equation 3.2 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a> for <math id="S3.SS3.p25.m2" class="ltx_Math" alttext="n=1,\,2,\,3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn> 2</mn><mo>,</mo><mn> 3</mn></mrow><annotation encoding="application/x-tex">n=1,\,2,\,3</annotation></semantics></math> to find the minimal solution <math id="S3.SS3.p25.m3" class="ltx_Math" alttext="f_{i}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>i</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">f_{i}=1</annotation></semantics></math> for all <math id="S3.SS3.p25.m4" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>. Thus, we set <math id="S3.SS3.p25.m5" class="ltx_Math" alttext="T_{1}=T_{2}=T_{3}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>=</mo><msub><mi>T</mi><mn>2</mn></msub><mo>=</mo><msub><mi>T</mi><mn>3</mn></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">T_{1}=T_{2}=T_{3}=1</annotation></semantics></math>. For <math id="S3.SS3.p25.m6" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math>, we use the above recursive formula. By the OEIS Sequence A058279 <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib12" title="" class="ltx_ref">Sloan and Inc. (2024)</a></cite>, <math id="S3.SS3.p25.m7" class="ltx_Math" alttext="T_{n}=\Theta((n-1)!)" display="inline" intent=":literal"><semantics><mrow><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T_{n}=\Theta((n-1)!)</annotation></semantics></math>.</span></p>
</div>
<div id="S3.SS3.p26" class="ltx_para">
<p id="S3.SS3.p26.1" class="ltx_p"><span id="S3.SS3.p26.1.1" class="ltx_text">Recall that <math id="S3.SS3.p26.m1" class="ltx_Math" alttext="f_{i}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>i</mi></msub><annotation encoding="application/x-tex">f_{i}</annotation></semantics></math> is the number of times that <math id="S3.SS3.p26.m2" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> fires in the first <math id="S3.SS3.p26.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> rounds. Thus, <math id="S3.SS3.p26.m4" class="ltx_Math" alttext="T\geq f_{i}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><msub><mi>f</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">T\geq f_{i}</annotation></semantics></math>. Since <math id="S3.SS3.p26.m5" class="ltx_Math" alttext="f_{3}\geq T_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>3</mn></msub><mo>≥</mo><msub><mi>T</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">f_{3}\geq T_{n}</annotation></semantics></math> for <math id="S3.SS3.p26.m6" class="ltx_Math" alttext="n\geq 4" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">n\geq 4</annotation></semantics></math> and <math id="S3.SS3.p26.m7" class="ltx_Math" alttext="f_{1}\geq T_{n}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mn>1</mn></msub><mo>≥</mo><msub><mi>T</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">f_{1}\geq T_{n}</annotation></semantics></math> for <math id="S3.SS3.p26.m8" class="ltx_Math" alttext="n\leq 3" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≤</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">n\leq 3</annotation></semantics></math>, we have that <math id="S3.SS3.p26.m9" class="ltx_Math" alttext="T\geq T_{n}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>≥</mo><msub><mi>T</mi><mi>n</mi></msub></mrow><annotation encoding="application/x-tex">T\geq T_{n}</annotation></semantics></math> for all parallel chip-firing games in which at least one vertex fires each round. Thus,</span></p>
<table id="S3.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex4.m1" class="ltx_Math" alttext="T_{c}(K_{n})\geq T_{n}=\Theta((n-1)!)\implies T_{c}(K_{n})=\Omega((n-1)!)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>T</mi><mi>n</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">⟹</mo><mrow><msub><mi>T</mi><mi>c</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>K</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi mathvariant="normal">Ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo>!</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{c}(K_{n})\geq T_{n}=\Theta((n-1)!)\implies T_{c}(K_{n})=\Omega((n-1)!).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right"><math id="S3.Ex4.m2" class="ltx_Math" display="inline" intent=":literal"><mphantom></mphantom></math></span></td></tr></tbody>
</table>
</div>
</div>
<div id="S3.Thmtheorem11" class="ltx_theorem ltx_theorem_example">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S3.Thmtheorem11.2" class="ltx_text ltx_font_bold">Example 3.11</span></span><span id="S3.Thmtheorem11.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S3.Thmtheorem11.p1" class="ltx_para">
<p id="S3.Thmtheorem11.p1.1" class="ltx_p">Figure <a href="#S3.F4" title="Figure 4 ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> shows an example of a parallel chip-firing game on <math id="S3.Thmtheorem11.p1.m1" class="ltx_Math" alttext="K_{4}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>4</mn></msub><annotation encoding="application/x-tex">K_{4}</annotation></semantics></math> with <math id="S3.Thmtheorem11.p1.m2" class="ltx_Math" alttext="T=T_{4}=4" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><msub><mi>T</mi><mn>4</mn></msub><mo>=</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">T=T_{4}=4</annotation></semantics></math>. The vector <math id="S3.Thmtheorem11.p1.m3" class="ltx_Math" alttext="(f_{1},\,f_{2},\,f_{3},\,f_{4})=(1,\,3,\,4,\,2)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><msub><mi>f</mi><mn>2</mn></msub><mo>,</mo><msub><mi>f</mi><mn>3</mn></msub><mo>,</mo><msub><mi>f</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn> 3</mn><mo>,</mo><mn> 4</mn><mo>,</mo><mn> 2</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(f_{1},\,f_{2},\,f_{3},\,f_{4})=(1,\,3,\,4,\,2)</annotation></semantics></math> is indeed a solution to System <a href="#S3.E1" title="Equation 3.1 ‣ Proof. ‣ 3.3 Complete Graphs ‣ 3 Period Lengths of Parallel Chip-Firing Games ‣ Periods and Atomic Firing Sequences of Parallel Chip-Firing Games on Directed Graphs" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> for <math id="S3.Thmtheorem11.p1.m4" class="ltx_Math" alttext="K_{4}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><mn>4</mn></msub><annotation encoding="application/x-tex">K_{4}</annotation></semantics></math>.</p>
</div>
</div>
<figure id="S3.F4" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<div id="S3.F4.2" class="ltx_inline-block ltx_figure_panel ltx_align_center ltx_transformed_outer" style="width:78.7pt;height:114.7pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(9.1pt,-13.2pt) scale(1.3,1.3) ;"><span class="ltx_inline-block"><svg id="S3.F4.pic1" class="ltx_picture" height="122.05" overflow="visible" version="1.1" viewBox="0 0 83.78 122.05" width="83.78"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="translate(0,122.05) matrix(1 0 0 -1 0 0) translate(12.36,0) translate(0,31.5)"><g stroke-linecap="round" stroke-linejoin="round" stroke-width="0.8pt"><path style="fill:none" d="M 11.81 59.06 C 11.81 65.58 6.52 70.87 0 70.87 C -6.52 70.87 -11.81 65.58 -11.81 59.06 C -11.81 52.53 -6.52 47.24 0 47.24 C 6.52 47.24 11.81 52.53 11.81 59.06 Z M 0 59.06"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 55.49)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.1" class="ltx_text" style="font-size:80%;">1</span></span></span></foreignObject></g><path style="fill:none" d="M 70.87 59.06 C 70.87 65.58 65.58 70.87 59.06 70.87 C 52.53 70.87 47.24 65.58 47.24 59.06 C 47.24 52.53 52.53 47.24 59.06 47.24 C 65.58 47.24 70.87 52.53 70.87 59.06 Z M 59.06 59.06"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.11 55.49)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.2" class="ltx_text" style="font-size:80%;">2</span></span></span></foreignObject></g><path style="fill:none" d="M 70.87 0 C 70.87 6.52 65.58 11.81 59.06 11.81 C 52.53 11.81 47.24 6.52 47.24 0 C 47.24 -6.52 52.53 -11.81 59.06 -11.81 C 65.58 -11.81 70.87 -6.52 70.87 0 Z M 59.06 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.11 -3.57)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.3" class="ltx_text" style="font-size:80%;">3</span></span></span></foreignObject></g><path style="fill:none" d="M 11.81 0 C 11.81 6.52 6.52 11.81 0 11.81 C -6.52 11.81 -11.81 6.52 -11.81 0 C -11.81 -6.52 -6.52 -11.81 0 -11.81 C 6.52 -11.81 11.81 -6.52 11.81 0 Z M 0 0"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 -3.57)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.4" class="ltx_text" style="font-size:80%;">4</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 75.17)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.5" class="ltx_text" style="font-size:80%;">1</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.11 75.17)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.6" class="ltx_text" style="font-size:80%;">0</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 56.11 -23.25)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.7" class="ltx_text" style="font-size:80%;">2</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -2.94 -23.25)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.61em;--ltx-fo-depth:0em;font-size:8.5pt;" height="7.13" overflow="visible" transform="matrix(1 0 0 -1 0 7.13)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F4.pic1.8" class="ltx_text" style="font-size:80%;">2</span></span></span></foreignObject></g><path style="fill:none" d="M 12.36 59.06 L 45.71 59.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.64pt" transform="matrix(1.0 0.0 0.0 1.0 45.71 59.06)"><path style="fill:none" d="M -2.16 2.88 C -1.98 1.8 0 0.18 0.54 0 C 0 -0.18 -1.98 -1.8 -2.16 -2.88"></path></g><path style="fill:none" d="M 