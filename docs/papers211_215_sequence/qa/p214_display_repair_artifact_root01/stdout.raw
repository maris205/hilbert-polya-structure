sr/share/texlive/texmf-dist/tex/latex/base/ts1cmr.fd: OK\n/usr/share/texlive/texmf-dist/tex/latex/l3backend/l3backend-pdftex.def: OK\n/usr/share/texlive/texmf-dist/web2c/texmf.cnf: OK\n/usr/share/texmf/ls-R: OK\n/usr/share/texmf/web2c/texmf.cnf: OK\n/var/lib/texmf/fonts/map/pdftex/updmap/pdftex.map: OK\n/var/lib/texmf/ls-R: OK\n/var/lib/texmf/tex/generic/tex-ini-files/pdftexconfig.tex: OK\n/var/lib/texmf/web2c/pdftex/pdflatex.fmt: OK\n/usr/share/texlive/texmf-dist/fonts/map/fontname/texfonts.map: OK\n"
