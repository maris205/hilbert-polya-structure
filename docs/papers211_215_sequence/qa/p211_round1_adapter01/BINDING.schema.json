{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p211:round1:binding:v1",
  "title": "P211 Round1 exact root binding; the pending template intentionally fails this enabled-execution schema",
  "description": "No schema assertion adjudicates A's science or authorizes execution. Root must first receive the whole final originals and supply every exact pin, set, historical resolution and acceptance record. The recorder applies additional cross-field, full byte, directory, inode and native checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "p211_round1_binding_v1"
    },
    "enabled": {
      "const": true
    },
    "execution_directory": {
      "const": "docs/papers211_215_sequence/qa/p211_round1_execution01"
    },
    "root_authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "const": "/root"
        },
        "decision": {
          "const": "AUTHORIZE_PHYSICAL_P211_ROUND1_FROM_ACCEPTED_FINAL_A"
        },
        "record": {
          "$ref": "#/$defs/evidenceReference"
        }
      },
      "required": [
        "issuer",
        "decision",
        "record"
      ]
    },
    "execution_source_pin": {
      "$ref": "#/$defs/pin"
    },
    "preparation_manifest": {
      "$ref": "#/$defs/evidenceReference"
    },
    "role_preparation_manifest": {
      "$ref": "#/$defs/evidenceReference"
    },
    "author_delta_before": {
      "$ref": "#/$defs/authorPins"
    },
    "author_delta_after": {
      "$ref": "#/$defs/authorPins"
    },
    "acceptance_references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "round0_root_reception": {
          "$ref": "#/$defs/evidenceReference"
        },
        "round0_complete_execution_read_key": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_final_report": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_final_findings": {
          "$ref": "#/$defs/evidenceReference"
        },
        "root_exact_response": {
          "$ref": "#/$defs/evidenceReference"
        },
        "same_a_accepted_delta": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_same_reviewer_acceptance": {
          "$ref": "#/$defs/evidenceReference"
        },
        "root_whole_a_reception": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_initial_output_reception": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_exclusive_canonical_adoption": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_strict_pair_and_three_native_comparisons": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_complete_runtime_dependency_key": {
          "$ref": "#/$defs/evidenceReference"
        },
        "a_schema_and_parameter_explanation": {
          "$ref": "#/$defs/evidenceReference"
        },
        "accepted_build_complete_key": {
          "$ref": "#/$defs/evidenceReference"
        },
        "actual_all_page_view_reception": {
          "$ref": "#/$defs/evidenceReference"
        },
        "author_delta_before_key": {
          "$ref": "#/$defs/evidenceReference"
        },
        "author_delta_after_key": {
          "$ref": "#/$defs/evidenceReference"
        }
      },
      "required": [
        "round0_root_reception",
        "round0_complete_execution_read_key",
        "a_final_report",
        "a_final_findings",
        "root_exact_response",
        "same_a_accepted_delta",
        "a_same_reviewer_acceptance",
        "root_whole_a_reception",
        "a_initial_output_reception",
        "a_exclusive_canonical_adoption",
        "a_strict_pair_and_three_native_comparisons",
        "a_complete_runtime_dependency_key",
        "a_schema_and_parameter_explanation",
        "accepted_build_complete_key",
        "actual_all_page_view_reception",
        "author_delta_before_key",
        "author_delta_after_key"
      ]
    },
    "a_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer": {
          "const": "/root/round211_rational_scout/relation_primary_sources/lyndon_primary_check"
        },
        "current_open_findings": {
          "const": 0
        },
        "same_reviewer_accepted_exact_delta": {
          "const": true
        },
        "root_received_whole_originals": {
          "const": true
        },
        "accepted_final_manifest_pin": {
          "$ref": "#/$defs/pin"
        }
      },
      "required": [
        "reviewer",
        "current_open_findings",
        "same_reviewer_accepted_exact_delta",
        "root_received_whole_originals",
        "accepted_final_manifest_pin"
      ]
    },
    "a_package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "const": "docs/papers211_215_sequence/reviews/p211_a"
        },
        "manifest_pin": {
          "$ref": "#/$defs/pin"
        },
        "payloads": {
          "$ref": "#/$defs/pinMap"
        },
        "payload_count": {
          "type": "integer",
          "minimum": 10
        },
        "all_file_count": {
          "type": "integer",
          "minimum": 11
        }
      },
      "required": [
        "root",
        "manifest_pin",
        "payloads",
        "payload_count",
        "all_file_count"
      ]
    },
    "host_reuse_boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "ROOT_SEPARATE_COMPLETE_HOST_KEY_AND_SETTINGS_RECHECK"
        },
        "complete_host_key_reference": {
          "$ref": "#/$defs/evidenceReference"
        },
        "accepted_runtime_settings_reference": {
          "$ref": "#/$defs/evidenceReference"
        },
        "precopy_recheck_reference": {
          "$ref": "#/$defs/evidenceReference"
        },
        "postcopy_root_recheck_required": {
          "const": true
        },
        "recorder_rehashes_complete_host_key": {
          "const": false
        }
      },
      "required": [
        "mode",
        "complete_host_key_reference",
        "accepted_runtime_settings_reference",
        "precopy_recheck_reference",
        "postcopy_root_recheck_required",
        "recorder_rehashes_complete_host_key"
      ]
    },
    "external_inputs": {
      "description": "Complete explicitly bound ordinary workspace-relative prerequisite files. Host ledgers may be consumed as files, but this table never represents outside-workspace or symlink host referents. Root separately rechecks the complete host key/settings through host_reuse_boundary.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "physical_path": {
            "$ref": "#/$defs/relativePath"
          },
          "pin": {
            "$ref": "#/$defs/pin"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "logical_paths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "physical_path",
          "pin",
          "roles",
          "logical_paths"
        ]
      }
    },
    "external_trees": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": {
            "$ref": "#/$defs/relativePath"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relativePath"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "manifest": {
            "enum": [
              "SHA256SUMS",
              null
            ]
          },
          "accepted_scope_reference": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "required": [
          "root",
          "files",
          "manifest",
          "accepted_scope_reference"
        ]
      }
    },
    "round0_read_resolutions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "round0_external_resolutions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "native_tool_pins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "/usr/bin/cp": {
          "$ref": "#/$defs/pin"
        },
        "/usr/bin/cmp": {
          "$ref": "#/$defs/pin"
        },
        "/usr/bin/sha256sum": {
          "$ref": "#/$defs/pin"
        },
        "/usr/bin/python3.10": {
          "$ref": "#/$defs/pin"
        }
      },
      "required": [
        "/usr/bin/cp",
        "/usr/bin/cmp",
        "/usr/bin/sha256sum",
        "/usr/bin/python3.10"
      ]
    },
    "pin_list_bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document": {
            "$ref": "#/$defs/relativePath"
          },
          "base": {
            "type": "string",
            "description": "Empty string means workspace root; otherwise exact normalized workspace-relative original base. Never the new frozen location."
          },
          "accepted_origin_reference": {
            "$ref": "#/$defs/evidenceReference"
          },
          "resolutions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        "required": [
          "document",
          "base",
          "accepted_origin_reference",
          "resolutions"
        ]
      }
    },
    "json_pin_bases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base": {
            "type": "string",
            "description": "Empty string means workspace root; otherwise exact normalized workspace-relative original base. Never the new frozen location."
          },
          "accepted_origin_and_schema_reference": {
            "$ref": "#/$defs/evidenceReference"
          },
          "scope_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "base",
          "accepted_origin_and_schema_reference",
          "scope_note"
        ]
      }
    },
    "document_origins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "original_document": {
            "$ref": "#/$defs/relativePath"
          },
          "accepted_origin_reference": {
            "anyOf": [
              {
                "$ref": "#/$defs/evidenceReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "local_links": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/localLink"
            }
          }
        },
        "required": [
          "original_document",
          "accepted_origin_reference",
          "local_links"
        ]
      }
    }
  },
  "required": [
    "schema",
    "enabled",
    "execution_directory",
    "root_authorization",
    "execution_source_pin",
    "preparation_manifest",
    "role_preparation_manifest",
    "author_delta_before",
    "author_delta_after",
    "acceptance_references",
    "a_acceptance",
    "a_package",
    "external_inputs",
    "host_reuse_boundary",
    "external_trees",
    "round0_read_resolutions",
    "round0_external_resolutions",
    "native_tool_pins",
    "pin_list_bases",
    "json_pin_bases",
    "document_origins"
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace- or declared-base-relative, normalized POSIX path. Recorder additionally rejects absolute paths, dot/dot-dot components, duplicate separators, backslash, NUL, CR/LF/TAB and trailing separators."
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "bytes",
        "sha256"
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "pin": {
          "$ref": "#/$defs/pin"
        }
      },
      "required": [
        "path",
        "pin"
      ]
    },
    "pinMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/pin"
      },
      "propertyNames": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "authorPins": {
      "type": "object",
      "properties": {
        "AUTHOR_EXECUTION_RECEIPT.md": {
          "$ref": "#/$defs/pin"
        },
        "CANONICAL.json": {
          "$ref": "#/$defs/pin"
        },
        "CANONICAL_SCHEMA.md": {
          "$ref": "#/$defs/pin"
        },
        "CLAIMS_EVIDENCE.md": {
          "$ref": "#/$defs/pin"
        },
        "HANDOFF.md": {
          "$ref": "#/$defs/pin"
        },
        "INITIAL_BUILD_RECEIPT.md": {
          "$ref": "#/$defs/pin"
        },
        "NARRATIVE_REPORT.md": {
          "$ref": "#/$defs/pin"
        },
        "PAPER_PLAN.md": {
          "$ref": "#/$defs/pin"
        },
        "PARAMETER_SPECIFICATION.md": {
          "$ref": "#/$defs/pin"
        },
        "PREPARATION_PLAN.md": {
          "$ref": "#/$defs/pin"
        },
        "PROOF_PACKAGE.md": {
          "$ref": "#/$defs/pin"
        },
        "README.md": {
          "$ref": "#/$defs/pin"
        },
        "SOURCE_AUDIT.md": {
          "$ref": "#/$defs/pin"
        },
        "SOURCE_INPUT_PINS.json": {
          "$ref": "#/$defs/pin"
        },
        "SOURCE_PIN_COLLECTION_TOOL_RETURN.json": {
          "$ref": "#/$defs/pin"
        },
        "SOURCE_PREPARATION_MANIFEST.json": {
          "$ref": "#/$defs/pin"
        },
        "STATIC_CHECK_TOOL_RETURN.json": {
          "$ref": "#/$defs/pin"
        },
        "main.pdf": {
          "$ref": "#/$defs/pin"
        },
        "main.tex": {
          "$ref": "#/$defs/pin"
        },
        "math_commands.tex": {
          "$ref": "#/$defs/pin"
        },
        "parameters.json": {
          "$ref": "#/$defs/pin"
        },
        "references.bib": {
          "$ref": "#/$defs/pin"
        },
        "sections/0_abstract.tex": {
          "$ref": "#/$defs/pin"
        },
        "sections/1_introduction.tex": {
          "$ref": "#/$defs/pin"
        },
        "sections/2_image.tex": {
          "$ref": "#/$defs/pin"
        },
        "sections/3_clock.tex": {
          "$ref": "#/$defs/pin"
        },
        "sections/4_inverse.tex": {
          "$ref": "#/$defs/pin"
        },
        "sections/5_scope.tex": {
          "$ref": "#/$defs/pin"
        },
        "sources/bibliographic_metadata_web.json": {
          "$ref": "#/$defs/pin"
        },
        "sources/stein_definition_web.json": {
          "$ref": "#/$defs/pin"
        },
        "sources/stein_support_web.json": {
          "$ref": "#/$defs/pin"
        },
        "verify.py": {
          "$ref": "#/$defs/pin"
        }
      },
      "required": [
        "AUTHOR_EXECUTION_RECEIPT.md",
        "CANONICAL.json",
        "CANONICAL_SCHEMA.md",
        "CLAIMS_EVIDENCE.md",
        "HANDOFF.md",
        "INITIAL_BUILD_RECEIPT.md",
        "NARRATIVE_REPORT.md",
        "PAPER_PLAN.md",
        "PARAMETER_SPECIFICATION.md",
        "PREPARATION_PLAN.md",
        "PROOF_PACKAGE.md",
        "README.md",
        "SOURCE_AUDIT.md",
        "SOURCE_INPUT_PINS.json",
        "SOURCE_PIN_COLLECTION_TOOL_RETURN.json",
        "SOURCE_PREPARATION_MANIFEST.json",
        "STATIC_CHECK_TOOL_RETURN.json",
        "main.pdf",
        "main.tex",
        "math_commands.tex",
        "parameters.json",
        "references.bib",
        "sections/0_abstract.tex",
        "sections/1_introduction.tex",
        "sections/2_image.tex",
        "sections/3_clock.tex",
        "sections/4_inverse.tex",
        "sections/5_scope.tex",
        "sources/bibliographic_metadata_web.json",
        "sources/stein_definition_web.json",
        "sources/stein_support_web.json",
        "verify.py"
      ],
      "additionalProperties": false
    },
    "localLink": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string",
              "minLength": 1
            },
            "logical_target": {
              "$ref": "#/$defs/relativePath"
            },
            "target": {
              "$ref": "#/$defs/relativePath"
            },
            "kind": {
              "const": "copied"
            }
          },
          "required": [
            "href",
            "logical_target",
            "target",
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string",
              "minLength": 1
            },
            "logical_target": {
              "$ref": "#/$defs/relativePath"
            },
            "target": {
              "$ref": "#/$defs/relativePath"
            },
            "kind": {
              "const": "external_file"
            },
            "accepted_resolution_reference": {
              "$ref": "#/$defs/evidenceReference"
            }
          },
          "required": [
            "href",
            "logical_target",
            "target",
            "kind",
            "accepted_resolution_reference"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "href": {
              "type": "string",
              "minLength": 1
            },
            "logical_target": {
              "$ref": "#/$defs/relativePath"
            },
            "target": {
              "$ref": "#/$defs/relativePath"
            },
            "kind": {
              "const": "external_directory"
            },
            "directory_files": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relativePath"
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "accepted_resolution_reference": {
              "$ref": "#/$defs/evidenceReference"
            }
          },
          "required": [
            "href",
            "logical_target",
            "target",
            "kind",
            "directory_files",
            "accepted_resolution_reference"
          ]
        }
      ]
    },
    "invocationAttempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "const": [
            "/usr/bin/python3.10",
            "-I",
            "-S",
            "-B",
            "/root/autodl-tmp/symbolic_dynamics/docs/papers211_215_sequence/qa/p211_round1_execution01/freeze.py",
            "--binding",
            "/root/autodl-tmp/symbolic_dynamics/docs/papers211_215_sequence/qa/p211_round1_execution01/BINDING.json"
          ]
        },
        "cwd": {
          "const": "/root/autodl-tmp/symbolic_dynamics"
        },
        "environment": {
          "const": {
            "PATH": "/usr/bin:/bin",
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
            "TZ": "UTC"
          }
        },
        "source_pin": {
          "$ref": "#/$defs/pin"
        },
        "binding_pin": {
          "$ref": "#/$defs/pin"
        },
        "started_epoch": {
          "type": "number"
        },
        "stdin": {
          "const": "subprocess.DEVNULL"
        }
      },
      "required": [
        "argv",
        "cwd",
        "environment",
        "source_pin",
        "binding_pin",
        "started_epoch",
        "stdin"
      ]
    }
  }
}
